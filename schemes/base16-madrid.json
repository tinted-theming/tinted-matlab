{
  "ColorSchemeName": "Madrid",
  "ColorSchemeAuthor": "xscriptor (https://github.com/xscriptor)",
  "Note": "Apply this theme in Matlab using the tinted_import function, available at https://github.com/tinted-theming/tinted-matlab",

  "matlab": {
    "colors": {
      "ForegroundColor": [26, 26, 26],
      "BackgroundColor": [250, 250, 250],
      "KeywordColor": [77, 38, 153],
      "CommentColor": [77, 77, 77],
      "StringColor": [0, 122, 40],
      "UnterminatedStringColor": [102, 35, 16],
      "SystemCommandColor": [0, 122, 158],
      "SyntaxErrorColor": [153, 0, 38],
      "commandwindow": {
        "HyperlinkColor": [0, 122, 158],
        "ErrorColor": [153, 0, 38],
        "WarningColor": [138, 100, 8]
      },
      "programmingtools": {
        "CodeAnalyzerWarningColor": [138, 100, 8],
        "AutofixHighlightColor": [138, 100, 8],
        "VariableHighlightColor": [0, 122, 158],
        "VariablesWithSharedScopeColor": [146, 50, 23]
      }
    },
    "editor": {
