{
  "ColorSchemeName": "Lumina Dusk Light",
  "ColorSchemeAuthor": "Razik Ikhlef (https://github.com/RazikSF)",
  "Note": "Apply this theme in Matlab using the tinted_import function, available at https://github.com/tinted-theming/tinted-matlab",

  "matlab": {
    "colors": {
      "ForegroundColor": [63, 51, 65],
      "BackgroundColor": [241, 234, 242],
      "KeywordColor": [90, 77, 145],
      "CommentColor": [208, 199, 210],
      "StringColor": [39, 105, 58],
      "UnterminatedStringColor": [111, 44, 121],
      "SystemCommandColor": [0, 101, 118],
      "SyntaxErrorColor": [136, 35, 34],
