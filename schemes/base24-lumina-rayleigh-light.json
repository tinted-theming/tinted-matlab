{
  "ColorSchemeName": "Lumina Rayleigh Light",
  "ColorSchemeAuthor": "Razik Ikhlef (https://github.com/RazikSF)",
  "Note": "Apply this theme in Matlab using the tinted_import function, available at https://github.com/tinted-theming/tinted-matlab",

  "matlab": {
    "colors": {
      "ForegroundColor": [29, 47, 71],
      "BackgroundColor": [237, 248, 255],
      "KeywordColor": [114, 68, 169],
      "CommentColor": [200, 214, 223],
      "StringColor": [30, 119, 59],
      "UnterminatedStringColor": [141, 68, 135],
      "SystemCommandColor": [5, 98, 113],
      "SyntaxErrorColor": [148, 23, 27],
      "commandwindow": {
        "HyperlinkColor": [1, 96, 167],
        "ErrorColor": [148, 23, 27],
        "WarningColor": [163, 95, 0]
      },
      "programmingtools": {
        "CodeAnalyzerWarningColor": [163, 95, 0],
        "AutofixHighlightColor": [163, 95, 0],
        "VariableHighlightColor": [5, 98, 113],
        "VariablesWithSharedScopeColor": [161, 78, 20]
      }
    },
    "editor": {
      "displaysettings": {
        "HighlightCurrentLineColor": [227, 242, 251],
        "linelimit": {
          "LineColor": [216, 230, 240]
        }
      },
      "language": {
        "cpp": {
          "BadCharactersColor": [141, 68, 135],
          "CharactersColor": [5, 98, 113],
          "CommentColor": [200, 214, 223],
          "KeywordColor": [114, 68, 169],
          "PreprocessorColor": [161, 78, 20],
          "StringsColor": [30, 119, 59]
        },
        "html": {
          "AttributeNameColor": [161, 78, 20],
          "AttributeValueColor": [161, 78, 20],
          "CdataSectionColor": [1, 96, 167],
          "CharacterColor": [5, 98, 113],
          "CommentColor": [200, 214, 223],
          "DoctypeDeclarationColor": [30, 119, 59],
          "ErrorColor": [141, 68, 135],
          "OperatorColor": [114, 68, 169],
          "ProcessingInstructionColor": [30, 119, 59],
          "TagColor": [148, 23, 27]
        },
        "java": {
          "CharactersColor": [5, 98, 113],
          "CommentColor": [200, 214, 223],
          "KeywordColor": [114, 68, 169],
          "StringsColor": [30, 119, 59]
        },
        "tlc": {
          "CommentColor": [200, 214, 223],
          "KeywordColor": [114, 68, 169],
          "MacroColor": [161, 78, 20],
          "StringsColor": [30, 119, 59]
        },
        "verilog": {
          "CommentColor": [200, 214, 223],
          "KeywordColor": [114, 68, 169],
          "OperatorColor": [161, 78, 20],
          "StringColor": [30, 119, 59]
        },
        "vhdl": {
          "CommentColor": [200, 214, 223],
          "KeywordColor": [114, 68, 169],
          "OperatorColor": [161, 78, 20],
          "StringColor": [30, 119, 59]
        }
      }
    },
    "appdesigner": {
      "codeview": {
        "ReadonlyBackgroundColor": [216, 230, 240]
      }
    }
  }
}
