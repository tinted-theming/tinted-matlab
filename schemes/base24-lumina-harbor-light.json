{
  "ColorSchemeName": "Lumina Harbor Light",
  "ColorSchemeAuthor": "Razik Ikhlef (https://github.com/RazikSF)",
  "Note": "Apply this theme in Matlab using the tinted_import function, available at https://github.com/tinted-theming/tinted-matlab",

  "matlab": {
    "colors": {
      "ForegroundColor": [28, 45, 79],
      "BackgroundColor": [251, 245, 236],
      "KeywordColor": [103, 88, 168],
      "CommentColor": [218, 210, 198],
      "StringColor": [25, 120, 77],
      "UnterminatedStringColor": [139, 73, 154],
      "SystemCommandColor": [4, 104, 113],
      "SyntaxErrorColor": [140, 28, 29],
      "commandwindow": {
        "HyperlinkColor": [4, 104, 164],
        "ErrorColor": [140, 28, 29],
        "WarningColor": [162, 95, 6]
      },
      "programmingtools": {
        "CodeAnalyzerWarningColor": [162, 95, 6],
        "AutofixHighlightColor": [162, 95, 6],
        "VariableHighlightColor": [4, 104, 113],
        "VariablesWithSharedScopeColor": [159, 80, 29]
      }
    },
    "editor": {
