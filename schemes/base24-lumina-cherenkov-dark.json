{
  "ColorSchemeName": "Lumina Cherenkov Dark",
  "ColorSchemeAuthor": "Razik Ikhlef (https://github.com/RazikSF)",
  "Note": "Apply this theme in Matlab using the tinted_import function, available at https://github.com/tinted-theming/tinted-matlab",

  "matlab": {
    "colors": {
      "ForegroundColor": [215, 231, 245],
      "BackgroundColor": [2, 17, 41],
      "KeywordColor": [199, 174, 254],
      "CommentColor": [20, 41, 70],
      "StringColor": [154, 216, 166],
      "UnterminatedStringColor": [236, 175, 230],
      "SystemCommandColor": [143, 231, 253],
      "SyntaxErrorColor": [219, 108, 100],
      "commandwindow": {
        "HyperlinkColor": [76, 161, 255],
        "ErrorColor": [219, 108, 100],
        "WarningColor": [234, 210, 147]
      },
      "programmingtools": {
        "CodeAnalyzerWarningColor": [234, 210, 147],
        "AutofixHighlightColor": [234, 210, 147],
        "VariableHighlightColor": [143, 231, 253],
        "VariablesWithSharedScopeColor": [251, 162, 111]
      }
    },
    "editor": {
      "displaysettings": {
        "HighlightCurrentLineColor": [3, 21, 48],
        "linelimit": {
          "LineColor": [10, 31, 59]
        }
      },
      "language": {
        "cpp": {
          "BadCharactersColor": [236, 175, 230],
          "CharactersColor": [143, 231, 253],
          "CommentColor": [20, 41, 70],
          "KeywordColor": [199, 174, 254],
          "PreprocessorColor": [251, 162, 111],
          "StringsColor": [154, 216, 166]
        },
        "html": {
          "AttributeNameColor": [251, 162, 111],
          "AttributeValueColor": [251, 162, 111],
          "CdataSectionColor": [76, 161, 255],
          "CharacterColor": [143, 231, 253],
          "CommentColor": [20, 41, 70],
          "DoctypeDeclarationColor": [154, 216, 166],
          "ErrorColor": [236, 175, 230],
          "OperatorColor": [199, 174, 254],
          "ProcessingInstructionColor": [154, 216, 166],
          "TagColor": [219, 108, 100]
        },
        "java": {
          "CharactersColor": [143, 231, 253],
          "CommentColor": [20, 41, 70],
          "KeywordColor": [199, 174, 254],
          "StringsColor": [154, 216, 166]
        },
        "tlc": {
          "CommentColor": [20, 41, 70],
          "KeywordColor": [199, 174, 254],
          "MacroColor": [251, 162, 111],
          "StringsColor": [154, 216, 166]
        },
        "verilog": {
          "CommentColor": [20, 41, 70],
          "KeywordColor": [199, 174, 254],
          "OperatorColor": [251, 162, 111],
          "StringColor": [154, 216, 166]
        },
        "vhdl": {
          "CommentColor": [20, 41, 70],
          "KeywordColor": [199, 174, 254],
          "OperatorColor": [251, 162, 111],
          "StringColor": [154, 216, 166]
        }
      }
    },
    "appdesigner": {
      "codeview": {
        "ReadonlyBackgroundColor": [10, 31, 59]
      }
    }
  }
}
