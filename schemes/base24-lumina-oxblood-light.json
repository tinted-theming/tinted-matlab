          "CommentColor": [222, 206, 209],
          "DoctypeDeclarationColor": [35, 119, 66],
          "ErrorColor": [130, 70, 157],
          "OperatorColor": [101, 86, 163],
          "ProcessingInstructionColor": [35, 119, 66],
          "TagColor": [155, 40, 39]
