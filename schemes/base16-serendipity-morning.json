          "CommentColor": [109, 114, 150],
          "DoctypeDeclarationColor": [47, 122, 171],
          "ErrorColor": [47, 122, 171],
          "OperatorColor": [120, 95, 208],
          "ProcessingInstructionColor": [47, 122, 171],
          "TagColor": [194, 90, 77]
        },
        "java": {
          "CharactersColor": [229, 134, 120],
          "CommentColor": [109, 114, 150],
          "KeywordColor": [120, 95, 208],
          "StringsColor": [47, 122, 171]
