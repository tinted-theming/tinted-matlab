{
  "ColorSchemeName": "Lumina Lagoon Dark",
  "ColorSchemeAuthor": "Razik Ikhlef (https://github.com/RazikSF)",
  "Note": "Apply this theme in Matlab using the tinted_import function, available at https://github.com/tinted-theming/tinted-matlab",

  "matlab": {
    "colors": {
      "ForegroundColor": [215, 230, 231],
      "BackgroundColor": [4, 41, 48],
      "KeywordColor": [200, 186, 246],
      "CommentColor": [28, 67, 75],
      "StringColor": [159, 212, 169],
      "UnterminatedStringColor": [229, 176, 223],
      "SystemCommandColor": [90, 211, 214],
      "SyntaxErrorColor": [211, 114, 106],
      "commandwindow": {
        "HyperlinkColor": [142, 195, 249],
        "ErrorColor": [211, 114, 106],
        "WarningColor": [231, 207, 148]
      },
      "programmingtools": {
        "CodeAnalyzerWarningColor": [231, 207, 148],
        "AutofixHighlightColor": [231, 207, 148],
        "VariableHighlightColor": [90, 211, 214],
        "VariablesWithSharedScopeColor": [249, 178, 131]
      }
    },
    "editor": {
      "displaysettings": {
        "HighlightCurrentLineColor": [4, 46, 54],
        "linelimit": {
          "LineColor": [16, 57, 65]
        }
      },
      "language": {
        "cpp": {
          "BadCharactersColor": [229, 176, 223],
          "CharactersColor": [90, 211, 214],
          "CommentColor": [28, 67, 75],
          "KeywordColor": [200, 186, 246],
          "PreprocessorColor": [249, 178, 131],
          "StringsColor": [159, 212, 169]
        },
        "html": {
          "AttributeNameColor": [249, 178, 131],
          "AttributeValueColor": [249, 178, 131],
          "CdataSectionColor": [142, 195, 249],
          "CharacterColor": [90, 211, 214],
          "CommentColor": [28, 67, 75],
          "DoctypeDeclarationColor": [159, 212, 169],
          "ErrorColor": [229, 176, 223],
          "OperatorColor": [200, 186, 246],
          "ProcessingInstructionColor": [159, 212, 169],
          "TagColor": [211, 114, 106]
        },
        "java": {
          "CharactersColor": [90, 211, 214],
          "CommentColor": [28, 67, 75],
          "KeywordColor": [200, 186, 246],
          "StringsColor": [159, 212, 169]
        },
        "tlc": {
          "CommentColor": [28, 67, 75],
          "KeywordColor": [200, 186, 246],
          "MacroColor": [249, 178, 131],
          "StringsColor": [159, 212, 169]
        },
        "verilog": {
          "CommentColor": [28, 67, 75],
          "KeywordColor": [200, 186, 246],
          "OperatorColor": [249, 178, 131],
          "StringColor": [159, 212, 169]
        },
        "vhdl": {
          "CommentColor": [28, 67, 75],
          "KeywordColor": [200, 186, 246],
          "OperatorColor": [249, 178, 131],
          "StringColor": [159, 212, 169]
        }
      }
    },
    "appdesigner": {
      "codeview": {
        "ReadonlyBackgroundColor": [16, 57, 65]
      }
    }
  }
}
