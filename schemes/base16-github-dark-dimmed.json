{
  "ColorSchemeName": "Github Dark Dimmed",
  "ColorSchemeAuthor": "Tinted Theming (https://github.com/tinted-theming)",
  "Note": "Apply this theme in Matlab using the tinted_import function, available at https://github.com/tinted-theming/tinted-matlab",

  "matlab": {
    "colors": {
      "ForegroundColor": [173, 186, 199],
      "BackgroundColor": [34, 39, 46],
      "KeywordColor": [244, 112, 103],
      "CommentColor": [99, 110, 123],
      "StringColor": [150, 208, 255],
      "UnterminatedStringColor": [255, 147, 138],
      "SystemCommandColor": [141, 219, 140],
      "SyntaxErrorColor": [246, 157, 80],
      "commandwindow": {
        "HyperlinkColor": [220, 189, 251],
        "ErrorColor": [246, 157, 80],
        "WarningColor": [174, 124, 20]
      },
      "programmingtools": {
        "CodeAnalyzerWarningColor": [174, 124, 20],
        "AutofixHighlightColor": [174, 124, 20],
        "VariableHighlightColor": [141, 219, 140],
        "VariablesWithSharedScopeColor": [108, 182, 255]
      }
    },
