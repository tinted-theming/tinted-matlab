{
  "ColorSchemeName": "Lumina Aurora Light",
  "ColorSchemeAuthor": "Razik Ikhlef (https://github.com/RazikSF)",
  "Note": "Apply this theme in Matlab using the tinted_import function, available at https://github.com/tinted-theming/tinted-matlab",

  "matlab": {
    "colors": {
      "ForegroundColor": [48, 42, 59],
      "BackgroundColor": [247, 246, 251],
      "KeywordColor": [82, 70, 99],
      "CommentColor": [212, 211, 218],
      "StringColor": [0, 109, 60],
      "UnterminatedStringColor": [154, 69, 128],
      "SystemCommandColor": [0, 109, 128],
      "SyntaxErrorColor": [134, 14, 35],
      "commandwindow": {
        "HyperlinkColor": [39, 101, 176],
        "ErrorColor": [134, 14, 35],
        "WarningColor": [155, 100, 0]
      },
      "programmingtools": {
        "CodeAnalyzerWarningColor": [155, 100, 0],
        "AutofixHighlightColor": [155, 100, 0],
        "VariableHighlightColor": [0, 109, 128],
        "VariablesWithSharedScopeColor": [160, 79, 25]
      }
    },
