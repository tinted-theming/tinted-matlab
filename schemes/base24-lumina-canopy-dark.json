{
  "ColorSchemeName": "Lumina Canopy Dark",
  "ColorSchemeAuthor": "Razik Ikhlef (https://github.com/RazikSF)",
  "Note": "Apply this theme in Matlab using the tinted_import function, available at https://github.com/tinted-theming/tinted-matlab",

  "matlab": {
    "colors": {
      "ForegroundColor": [216, 227, 214],
      "BackgroundColor": [12, 27, 16],
      "KeywordColor": [191, 184, 243],
      "CommentColor": [34, 52, 39],
      "StringColor": [153, 208, 164],
      "UnterminatedStringColor": [226, 172, 221],
      "SystemCommandColor": [134, 207, 215],
      "SyntaxErrorColor": [213, 112, 104],
      "commandwindow": {
        "HyperlinkColor": [154, 202, 241],
        "ErrorColor": [213, 112, 104],
        "WarningColor": [209, 204, 168]
      },
      "programmingtools": {
        "CodeAnalyzerWarningColor": [209, 204, 168],
        "AutofixHighlightColor": [209, 204, 168],
        "VariableHighlightColor": [134, 207, 215],
        "VariablesWithSharedScopeColor": [246, 174, 124]
      }
    },
    "editor": {
      "displaysettings": {
        "HighlightCurrentLineColor": [15, 32, 20],
        "linelimit": {
          "LineColor": [25, 42, 29]
        }
      },
      "language": {
        "cpp": {
          "BadCharactersColor": [226, 172, 221],
          "CharactersColor": [134, 207, 215],
          "CommentColor": [34, 52, 39],
          "KeywordColor": [191, 184, 243],
          "PreprocessorColor": [246, 174, 124],
          "StringsColor": [153, 208, 164]
        },
        "html": {
          "AttributeNameColor": [246, 174, 124],
          "AttributeValueColor": [246, 174, 124],
          "CdataSectionColor": [154, 202, 241],
          "CharacterColor": [134, 207, 215],
          "CommentColor": [34, 52, 39],
          "DoctypeDeclarationColor": [153, 208, 164],
          "ErrorColor": [226, 172, 221],
          "OperatorColor": [191, 184, 243],
          "ProcessingInstructionColor": [153, 208, 164],
          "TagColor": [213, 112, 104]
        },
        "java": {
          "CharactersColor": [134, 207, 215],
          "CommentColor": [34, 52, 39],
          "KeywordColor": [191, 184, 243],
          "StringsColor": [153, 208, 164]
        },
        "tlc": {
          "CommentColor": [34, 52, 39],
          "KeywordColor": [191, 184, 243],
          "MacroColor": [246, 174, 124],
          "StringsColor": [153, 208, 164]
        },
        "verilog": {
          "CommentColor": [34, 52, 39],
          "KeywordColor": [191, 184, 243],
          "OperatorColor": [246, 174, 124],
          "StringColor": [153, 208, 164]
        },
        "vhdl": {
          "CommentColor": [34, 52, 39],
          "KeywordColor": [191, 184, 243],
          "OperatorColor": [246, 174, 124],
          "StringColor": [153, 208, 164]
        }
      }
    },
    "appdesigner": {
      "codeview": {
        "ReadonlyBackgroundColor": [25, 42, 29]
      }
    }
  }
}
