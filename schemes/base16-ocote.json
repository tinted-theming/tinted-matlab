{
  "ColorSchemeName": "Ocote",
  "ColorSchemeAuthor": "Teshre",
  "Note": "Apply this theme in Matlab using the tinted_import function, available at https://github.com/tinted-theming/tinted-matlab",

  "matlab": {
    "colors": {
      "ForegroundColor": [231, 220, 198],
      "BackgroundColor": [20, 16, 12],
      "KeywordColor": [197, 138, 224],
      "CommentColor": [107, 98, 83],
      "StringColor": [125, 201, 122],
      "UnterminatedStringColor": [74, 62, 44],
      "SystemCommandColor": [109, 216, 200],
      "SyntaxErrorColor": [232, 99, 90],
      "commandwindow": {
