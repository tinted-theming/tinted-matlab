          "CharacterColor": [183, 220, 229],
          "CommentColor": [75, 53, 39],
          "DoctypeDeclarationColor": [146, 199, 156],
          "ErrorColor": [220, 142, 187],
          "OperatorColor": [182, 175, 232],
          "ProcessingInstructionColor": [146, 199, 156],
          "TagColor": [212, 113, 105]
        },
        "java": {
          "CharactersColor": [183, 220, 229],
          "CommentColor": [75, 53, 39],
          "KeywordColor": [182, 175, 232],
          "StringsColor": [146, 199, 156]
        },
        "tlc": {
          "CommentColor": [75, 53, 39],
          "KeywordColor": [182, 175, 232],
