{
  "ColorSchemeName": "Bosque",
  "ColorSchemeAuthor": "Teshre",
  "Note": "Apply this theme in Matlab using the tinted_import function, available at https://github.com/tinted-theming/tinted-matlab",

  "matlab": {
    "colors": {
      "ForegroundColor": [207, 229, 210],
      "BackgroundColor": [14, 20, 16],
      "KeywordColor": [184, 148, 208],
      "CommentColor": [92, 110, 94],
      "StringColor": [111, 197, 110],
      "UnterminatedStringColor": [53, 80, 62],
      "SystemCommandColor": [95, 208, 184],
      "SyntaxErrorColor": [226, 112, 106],
      "commandwindow": {
        "HyperlinkColor": [109, 174, 158],
        "ErrorColor": [226, 112, 106],
        "WarningColor": [200, 184, 74]
      },
      "programmingtools": {
        "CodeAnalyzerWarningColor": [200, 184, 74],
        "AutofixHighlightColor": [200, 184, 74],
        "VariableHighlightColor": [95, 208, 184],
        "VariablesWithSharedScopeColor": [125, 201, 122]
      }
    },
