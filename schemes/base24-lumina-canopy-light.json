          "AttributeValueColor": [156, 82, 36],
          "CdataSectionColor": [29, 92, 153],
          "CharacterColor": [0, 112, 131],
          "CommentColor": [206, 211, 204],
          "DoctypeDeclarationColor": [0, 121, 83],
          "ErrorColor": [158, 50, 125],
          "OperatorColor": [115, 96, 184],
          "ProcessingInstructionColor": [0, 121, 83],
          "TagColor": [156, 46, 44]
        },
        "java": {
          "CharactersColor": [0, 112, 131],
          "CommentColor": [206, 211, 204],
          "KeywordColor": [115, 96, 184],
          "StringsColor": [0, 121, 83]
        },
        "tlc": {
