{
  "ColorSchemeName": "Lumina Nebula Dark",
  "ColorSchemeAuthor": "Razik Ikhlef (https://github.com/RazikSF)",
  "Note": "Apply this theme in Matlab using the tinted_import function, available at https://github.com/tinted-theming/tinted-matlab",

  "matlab": {
    "colors": {
      "ForegroundColor": [221, 225, 236],
      "BackgroundColor": [22, 24, 38],
      "KeywordColor": [176, 164, 248],
      "CommentColor": [45, 48, 65],
      "StringColor": [143, 220, 186],
      "UnterminatedStringColor": [229, 174, 223],
      "SystemCommandColor": [136, 210, 218],
      "SyntaxErrorColor": [213, 112, 104],
      "commandwindow": {
        "HyperlinkColor": [198, 214, 232],
        "ErrorColor": [213, 112, 104],
        "WarningColor": [243, 192, 133]
      },
      "programmingtools": {
        "CodeAnalyzerWarningColor": [243, 192, 133],
        "AutofixHighlightColor": [243, 192, 133],
        "VariableHighlightColor": [136, 210, 218],
        "VariablesWithSharedScopeColor": [250, 177, 126]
      }
    },
    "editor": {
      "displaysettings": {
        "HighlightCurrentLineColor": [26, 28, 44],
        "linelimit": {
          "LineColor": [36, 38, 54]
        }
      },
      "language": {
        "cpp": {
          "BadCharactersColor": [229, 174, 223],
          "CharactersColor": [136, 210, 218],
          "CommentColor": [45, 48, 65],
          "KeywordColor": [176, 164, 248],
          "PreprocessorColor": [250, 177, 126],
          "StringsColor": [143, 220, 186]
        },
        "html": {
          "AttributeNameColor": [250, 177, 126],
          "AttributeValueColor": [250, 177, 126],
          "CdataSectionColor": [198, 214, 232],
          "CharacterColor": [136, 210, 218],
          "CommentColor": [45, 48, 65],
          "DoctypeDeclarationColor": [143, 220, 186],
          "ErrorColor": [229, 174, 223],
          "OperatorColor": [176, 164, 248],
          "ProcessingInstructionColor": [143, 220, 186],
          "TagColor": [213, 112, 104]
        },
        "java": {
          "CharactersColor": [136, 210, 218],
          "CommentColor": [45, 48, 65],
          "KeywordColor": [176, 164, 248],
          "StringsColor": [143, 220, 186]
        },
        "tlc": {
          "CommentColor": [45, 48, 65],
          "KeywordColor": [176, 164, 248],
          "MacroColor": [250, 177, 126],
          "StringsColor": [143, 220, 186]
        },
        "verilog": {
          "CommentColor": [45, 48, 65],
          "KeywordColor": [176, 164, 248],
          "OperatorColor": [250, 177, 126],
          "StringColor": [143, 220, 186]
        },
        "vhdl": {
          "CommentColor": [45, 48, 65],
          "KeywordColor": [176, 164, 248],
          "OperatorColor": [250, 177, 126],
          "StringColor": [143, 220, 186]
        }
      }
    },
    "appdesigner": {
      "codeview": {
        "ReadonlyBackgroundColor": [36, 38, 54]
      }
    }
  }
}
