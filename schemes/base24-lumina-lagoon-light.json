          "BadCharactersColor": [137, 73, 132],
          "CharactersColor": [0, 110, 113],
          "CommentColor": [197, 216, 216],
          "KeywordColor": [113, 83, 181],
          "PreprocessorColor": [146, 73, 24],
          "StringsColor": [46, 97, 71]
        },
        "html": {
          "AttributeNameColor": [146, 73, 24],
          "AttributeValueColor": [146, 73, 24],
          "CdataSectionColor": [24, 92, 169],
          "CharacterColor": [0, 110, 113],
          "CommentColor": [197, 216, 216],
          "DoctypeDeclarationColor": [46, 97, 71],
          "ErrorColor": [137, 73, 132],
          "OperatorColor": [113, 83, 181],
          "ProcessingInstructionColor": [46, 97, 71],
          "TagColor": [143, 33, 33]
        },
        "java": {
          "CharactersColor": [0, 110, 113],
          "CommentColor": [197, 216, 216],
          "KeywordColor": [113, 83, 181],
          "StringsColor": [46, 97, 71]
        },
        "tlc": {
          "CommentColor": [197, 216, 216],
          "KeywordColor": [113, 83, 181],
          "MacroColor": [146, 73, 24],
          "StringsColor": [46, 97, 71]
