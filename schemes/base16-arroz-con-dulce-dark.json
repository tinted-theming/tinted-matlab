{
  "ColorSchemeName": "Arroz con Dulce Dark",
  "ColorSchemeAuthor": "Richard Martinez",
  "Note": "Apply this theme in Matlab using the tinted_import function, available at https://github.com/tinted-theming/tinted-matlab",

  "matlab": {
    "colors": {
      "ForegroundColor": [242, 223, 192],
      "BackgroundColor": [33, 20, 15],
      "KeywordColor": [213, 138, 180],
      "CommentColor": [169, 133, 104],
      "StringColor": [212, 122, 80],
      "UnterminatedStringColor": [185, 119, 85],
      "SystemCommandColor": [217, 130, 118],
      "SyntaxErrorColor": [224, 122, 138],
