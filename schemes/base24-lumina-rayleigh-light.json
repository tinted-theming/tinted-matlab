{
  "ColorSchemeName": "Lumina Rayleigh Light",
  "ColorSchemeAuthor": "Razik Ikhlef (https://github.com/RazikSF)",
  "Note": "Apply this theme in Matlab using the tinted_import function, available at https://github.com/tinted-theming/tinted-matlab",

  "matlab": {
    "colors": {
      "ForegroundColor": [29, 38, 56],
      "BackgroundColor": [247, 251, 254],
      "KeywordColor": [105, 61, 156],
      "CommentColor": [211, 217, 221],
      "StringColor": [24, 117, 56],
      "UnterminatedStringColor": [164, 54, 135],
      "SystemCommandColor": [0, 92, 113],
      "SyntaxErrorColor": [148, 20, 25],
      "commandwindow": {
        "HyperlinkColor": [5, 85, 183],
        "ErrorColor": [148, 20, 25],
        "WarningColor": [155, 100, 0]
      },
      "programmingtools": {
        "CodeAnalyzerWarningColor": [155, 100, 0],
        "AutofixHighlightColor": [155, 100, 0],
        "VariableHighlightColor": [0, 92, 113],
        "VariablesWithSharedScopeColor": [162, 78, 15]
      }
    },
    "editor": {
      "displaysettings": {
        "HighlightCurrentLineColor": [239, 245, 249],
        "linelimit": {
          "LineColor": [227, 233, 237]
        }
      },
      "language": {
        "cpp": {
          "BadCharactersColor": [164, 54, 135],
          "CharactersColor": [0, 92, 113],
          "CommentColor": [211, 217, 221],
          "KeywordColor": [105, 61, 156],
          "PreprocessorColor": [162, 78, 15],
          "StringsColor": [24, 117, 56]
        },
        "html": {
          "AttributeNameColor": [162, 78, 15],
          "AttributeValueColor": [162, 78, 15],
          "CdataSectionColor": [5, 85, 183],
          "CharacterColor": [0, 92, 113],
          "CommentColor": [211, 217, 221],
          "DoctypeDeclarationColor": [24, 117, 56],
          "ErrorColor": [164, 54, 135],
          "OperatorColor": [105, 61, 156],
          "ProcessingInstructionColor": [24, 117, 56],
          "TagColor": [148, 20, 25]
        },
        "java": {
          "CharactersColor": [0, 92, 113],
          "CommentColor": [211, 217, 221],
          "KeywordColor": [105, 61, 156],
          "StringsColor": [24, 117, 56]
        },
        "tlc": {
          "CommentColor": [211, 217, 221],
          "KeywordColor": [105, 61, 156],
          "MacroColor": [162, 78, 15],
          "StringsColor": [24, 117, 56]
        },
        "verilog": {
          "CommentColor": [211, 217, 221],
          "KeywordColor": [105, 61, 156],
          "OperatorColor": [162, 78, 15],
          "StringColor": [24, 117, 56]
        },
        "vhdl": {
          "CommentColor": [211, 217, 221],
          "KeywordColor": [105, 61, 156],
          "OperatorColor": [162, 78, 15],
          "StringColor": [24, 117, 56]
        }
      }
    },
    "appdesigner": {
      "codeview": {
        "ReadonlyBackgroundColor": [227, 233, 237]
      }
    }
  }
}
