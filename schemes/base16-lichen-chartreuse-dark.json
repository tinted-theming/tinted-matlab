          "AttributeValueColor": [213, 173, 115],
          "CdataSectionColor": [120, 173, 196],
          "CharacterColor": [156, 198, 201],
          "CommentColor": [137, 146, 130],
          "DoctypeDeclarationColor": [131, 189, 165],
          "ErrorColor": [210, 160, 178],
          "OperatorColor": [191, 166, 212],
          "ProcessingInstructionColor": [131, 189, 165],
          "TagColor": [226, 139, 130]
        },
        "java": {
          "CharactersColor": [156, 198, 201],
          "CommentColor": [137, 146, 130],
          "KeywordColor": [191, 166, 212],
          "StringsColor": [131, 189, 165]
        },
        "tlc": {
          "CommentColor": [137, 146, 130],
          "KeywordColor": [191, 166, 212],
          "MacroColor": [213, 173, 115],
          "StringsColor": [131, 189, 165]
