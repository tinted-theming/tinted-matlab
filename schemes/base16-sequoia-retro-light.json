          "CharacterColor": [138, 101, 57],
          "CommentColor": [86, 87, 96],
          "DoctypeDeclarationColor": [74, 112, 78],
          "ErrorColor": [74, 112, 78],
          "OperatorColor": [191, 82, 56],
          "ProcessingInstructionColor": [74, 112, 78],
          "TagColor": [95, 121, 130]
        },
        "java": {
          "CharactersColor": [138, 101, 57],
          "CommentColor": [86, 87, 96],
          "KeywordColor": [191, 82, 56],
          "StringsColor": [74, 112, 78]
        },
        "tlc": {
