{
  "ColorSchemeName": "Lumina Aurora Light",
  "ColorSchemeAuthor": "Razik Ikhlef (https://github.com/RazikSF)",
  "Note": "Apply this theme in Matlab using the tinted_import function, available at https://github.com/tinted-theming/tinted-matlab",

  "matlab": {
    "colors": {
      "ForegroundColor": [22, 50, 54],
      "BackgroundColor": [242, 250, 249],
      "KeywordColor": [117, 79, 165],
      "CommentColor": [205, 216, 215],
      "StringColor": [2, 109, 67],
      "UnterminatedStringColor": [137, 76, 132],
      "SystemCommandColor": [0, 115, 134],
      "SyntaxErrorColor": [148, 42, 40],
      "commandwindow": {
        "HyperlinkColor": [66, 91, 122],
        "ErrorColor": [148, 42, 40],
        "WarningColor": [159, 97, 22]
      },
      "programmingtools": {
        "CodeAnalyzerWarningColor": [159, 97, 22],
        "AutofixHighlightColor": [159, 97, 22],
        "VariableHighlightColor": [0, 115, 134],
        "VariablesWithSharedScopeColor": [152, 80, 34]
      }
    },
    "editor": {
      "displaysettings": {
        "HighlightCurrentLineColor": [233, 244, 243],
        "linelimit": {
          "LineColor": [221, 233, 231]
        }
      },
      "language": {
        "cpp": {
          "BadCharactersColor": [137, 76, 132],
          "CharactersColor": [0, 115, 134],
          "CommentColor": [205, 216, 215],
          "KeywordColor": [117, 79, 165],
          "PreprocessorColor": [152, 80, 34],
          "StringsColor": [2, 109, 67]
        },
        "html": {
          "AttributeNameColor": [152, 80, 34],
          "AttributeValueColor": [152, 80, 34],
          "CdataSectionColor": [66, 91, 122],
          "CharacterColor": [0, 115, 134],
          "CommentColor": [205, 216, 215],
          "DoctypeDeclarationColor": [2, 109, 67],
          "ErrorColor": [137, 76, 132],
          "OperatorColor": [117, 79, 165],
          "ProcessingInstructionColor": [2, 109, 67],
          "TagColor": [148, 42, 40]
        },
        "java": {
          "CharactersColor": [0, 115, 134],
          "CommentColor": [205, 216, 215],
          "KeywordColor": [117, 79, 165],
          "StringsColor": [2, 109, 67]
        },
        "tlc": {
          "CommentColor": [205, 216, 215],
          "KeywordColor": [117, 79, 165],
          "MacroColor": [152, 80, 34],
          "StringsColor": [2, 109, 67]
        },
        "verilog": {
          "CommentColor": [205, 216, 215],
          "KeywordColor": [117, 79, 165],
          "OperatorColor": [152, 80, 34],
          "StringColor": [2, 109, 67]
        },
        "vhdl": {
          "CommentColor": [205, 216, 215],
          "KeywordColor": [117, 79, 165],
          "OperatorColor": [152, 80, 34],
          "StringColor": [2, 109, 67]
        }
      }
    },
    "appdesigner": {
      "codeview": {
        "ReadonlyBackgroundColor": [221, 233, 231]
      }
    }
