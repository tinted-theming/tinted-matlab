{
  "ColorSchemeName": "Apprentice",
  "ColorSchemeAuthor": "Romain Lafourcade (https://github.com/romainl)",
  "Note": "Apply this theme in Matlab using the tinted_import function, available at https://github.com/tinted-theming/tinted-matlab",

  "matlab": {
    "colors": {
      "ForegroundColor": [188, 188, 188],
      "BackgroundColor": [38, 38, 38],
      "KeywordColor": [95, 95, 135],
      "CommentColor": [68, 68, 68],
      "StringColor": [95, 135, 95],
      "UnterminatedStringColor": [175, 95, 95],
      "SystemCommandColor": [95, 135, 135],
      "SyntaxErrorColor": [175, 95, 95],
      "commandwindow": {
        "HyperlinkColor": [95, 135, 175],
        "ErrorColor": [175, 95, 95],
        "WarningColor": [135, 135, 95]
      },
      "programmingtools": {
        "CodeAnalyzerWarningColor": [135, 135, 95],
        "AutofixHighlightColor": [135, 135, 95],
        "VariableHighlightColor": [95, 135, 135],
        "VariablesWithSharedScopeColor": [255, 135, 0]
      }
    },
    "editor": {
      "displaysettings": {
        "HighlightCurrentLineColor": [48, 48, 48],
        "linelimit": {
          "LineColor": [58, 58, 58]
        }
      },
      "language": {
        "cpp": {
          "BadCharactersColor": [175, 95, 95],
          "CharactersColor": [95, 135, 135],
          "CommentColor": [68, 68, 68],
          "KeywordColor": [95, 95, 135],
          "PreprocessorColor": [255, 135, 0],
          "StringsColor": [95, 135, 95]
        },
        "html": {
          "AttributeNameColor": [255, 135, 0],
          "AttributeValueColor": [255, 135, 0],
          "CdataSectionColor": [95, 135, 175],
          "CharacterColor": [95, 135, 135],
          "CommentColor": [68, 68, 68],
          "DoctypeDeclarationColor": [95, 135, 95],
          "ErrorColor": [175, 95, 95],
          "OperatorColor": [95, 95, 135],
          "ProcessingInstructionColor": [95, 135, 95],
          "TagColor": [175, 95, 95]
        },
        "java": {
          "CharactersColor": [95, 135, 135],
          "CommentColor": [68, 68, 68],
          "KeywordColor": [95, 95, 135],
          "StringsColor": [95, 135, 95]
        },
        "tlc": {
          "CommentColor": [68, 68, 68],
          "KeywordColor": [95, 95, 135],
          "MacroColor": [255, 135, 0],
          "StringsColor": [95, 135, 95]
        },
        "verilog": {
          "CommentColor": [68, 68, 68],
          "KeywordColor": [95, 95, 135],
          "OperatorColor": [255, 135, 0],
          "StringColor": [95, 135, 95]
        },
        "vhdl": {
          "CommentColor": [68, 68, 68],
          "KeywordColor": [95, 95, 135],
          "OperatorColor": [255, 135, 0],
          "StringColor": [95, 135, 95]
        }
      }
    },
    "appdesigner": {
      "codeview": {
        "ReadonlyBackgroundColor": [58, 58, 58]
      }
    }
  }
}
