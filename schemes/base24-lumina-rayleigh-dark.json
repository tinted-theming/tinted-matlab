{
  "ColorSchemeName": "Lumina Rayleigh Dark",
  "ColorSchemeAuthor": "Razik Ikhlef (https://github.com/RazikSF)",
  "Note": "Apply this theme in Matlab using the tinted_import function, available at https://github.com/tinted-theming/tinted-matlab",

  "matlab": {
    "colors": {
      "ForegroundColor": [212, 223, 235],
      "BackgroundColor": [9, 29, 48],
      "KeywordColor": [191, 158, 241],
      "CommentColor": [31, 54, 77],
      "StringColor": [150, 210, 162],
      "UnterminatedStringColor": [238, 163, 201],
      "SystemCommandColor": [175, 222, 230],
      "SyntaxErrorColor": [217, 109, 101],
      "commandwindow": {
        "HyperlinkColor": [111, 195, 255],
        "ErrorColor": [217, 109, 101],
        "WarningColor": [241, 204, 121]
      },
      "programmingtools": {
        "CodeAnalyzerWarningColor": [241, 204, 121],
        "AutofixHighlightColor": [241, 204, 121],
        "VariableHighlightColor": [175, 222, 230],
        "VariablesWithSharedScopeColor": [250, 172, 119]
      }
    },
    "editor": {
      "displaysettings": {
        "HighlightCurrentLineColor": [11, 34, 55],
        "linelimit": {
          "LineColor": [21, 44, 66]
        }
      },
      "language": {
        "cpp": {
          "BadCharactersColor": [238, 163, 201],
          "CharactersColor": [175, 222, 230],
          "CommentColor": [31, 54, 77],
          "KeywordColor": [191, 158, 241],
          "PreprocessorColor": [250, 172, 119],
          "StringsColor": [150, 210, 162]
        },
        "html": {
          "AttributeNameColor": [250, 172, 119],
          "AttributeValueColor": [250, 172, 119],
          "CdataSectionColor": [111, 195, 255],
          "CharacterColor": [175, 222, 230],
          "CommentColor": [31, 54, 77],
          "DoctypeDeclarationColor": [150, 210, 162],
          "ErrorColor": [238, 163, 201],
          "OperatorColor": [191, 158, 241],
          "ProcessingInstructionColor": [150, 210, 162],
          "TagColor": [217, 109, 101]
        },
        "java": {
          "CharactersColor": [175, 222, 230],
          "CommentColor": [31, 54, 77],
          "KeywordColor": [191, 158, 241],
          "StringsColor": [150, 210, 162]
        },
        "tlc": {
          "CommentColor": [31, 54, 77],
          "KeywordColor": [191, 158, 241],
          "MacroColor": [250, 172, 119],
          "StringsColor": [150, 210, 162]
        },
        "verilog": {
          "CommentColor": [31, 54, 77],
          "KeywordColor": [191, 158, 241],
          "OperatorColor": [250, 172, 119],
          "StringColor": [150, 210, 162]
        },
        "vhdl": {
          "CommentColor": [31, 54, 77],
          "KeywordColor": [191, 158, 241],
          "OperatorColor": [250, 172, 119],
          "StringColor": [150, 210, 162]
        }
      }
    },
    "appdesigner": {
      "codeview": {
        "ReadonlyBackgroundColor": [21, 44, 66]
      }
    }
  }
}
