{
  "ColorSchemeName": "Lumina Nebula Light",
  "ColorSchemeAuthor": "Razik Ikhlef (https://github.com/RazikSF)",
  "Note": "Apply this theme in Matlab using the tinted_import function, available at https://github.com/tinted-theming/tinted-matlab",

  "matlab": {
    "colors": {
      "ForegroundColor": [31, 42, 56],
      "BackgroundColor": [246, 248, 251],
      "KeywordColor": [108, 77, 158],
      "CommentColor": [211, 213, 218],
      "StringColor": [46, 114, 65],
      "UnterminatedStringColor": [132, 72, 127],
      "SystemCommandColor": [0, 101, 126],
      "SyntaxErrorColor": [144, 39, 37],
      "commandwindow": {
        "HyperlinkColor": [52, 99, 158],
        "ErrorColor": [144, 39, 37],
        "WarningColor": [153, 96, 0]
      },
      "programmingtools": {
        "CodeAnalyzerWarningColor": [153, 96, 0],
        "AutofixHighlightColor": [153, 96, 0],
        "VariableHighlightColor": [0, 101, 126],
        "VariablesWithSharedScopeColor": [148, 77, 31]
      }
    },
    "editor": {
