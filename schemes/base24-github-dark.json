{
  "ColorSchemeName": "Github Dark",
  "ColorSchemeAuthor": "Tinted Theming (https://github.com/tinted-theming)",
  "Note": "Apply this theme in Matlab using the tinted_import function, available at https://github.com/tinted-theming/tinted-matlab",

  "matlab": {
    "colors": {
      "ForegroundColor": [201, 209, 217],
      "BackgroundColor": [13, 17, 23],
      "KeywordColor": [255, 123, 114],
      "CommentColor": [110, 118, 129],
      "StringColor": [165, 214, 255],
      "UnterminatedStringColor": [255, 161, 152],
      "SystemCommandColor": [126, 231, 135],
      "SyntaxErrorColor": [255, 166, 87],
      "commandwindow": {
        "HyperlinkColor": [210, 168, 255],
        "ErrorColor": [255, 166, 87],
        "WarningColor": [187, 128, 9]
      },
      "programmingtools": {
        "CodeAnalyzerWarningColor": [187, 128, 9],
        "AutofixHighlightColor": [187, 128, 9],
        "VariableHighlightColor": [126, 231, 135],
        "VariablesWithSharedScopeColor": [121, 192, 255]
      }
    },
    "editor": {
      "displaysettings": {
        "HighlightCurrentLineColor": [22, 27, 34],
        "linelimit": {
          "LineColor": [72, 79, 88]
        }
      },
      "language": {
        "cpp": {
          "BadCharactersColor": [255, 161, 152],
          "CharactersColor": [126, 231, 135],
          "CommentColor": [110, 118, 129],
          "KeywordColor": [255, 123, 114],
          "PreprocessorColor": [121, 192, 255],
          "StringsColor": [165, 214, 255]
        },
        "html": {
          "AttributeNameColor": [121, 192, 255],
          "AttributeValueColor": [121, 192, 255],
          "CdataSectionColor": [210, 168, 255],
          "CharacterColor": [126, 231, 135],
          "CommentColor": [110, 118, 129],
          "DoctypeDeclarationColor": [165, 214, 255],
          "ErrorColor": [255, 161, 152],
          "OperatorColor": [255, 123, 114],
          "ProcessingInstructionColor": [165, 214, 255],
          "TagColor": [255, 166, 87]
        },
        "java": {
          "CharactersColor": [126, 231, 135],
          "CommentColor": [110, 118, 129],
          "KeywordColor": [255, 123, 114],
          "StringsColor": [165, 214, 255]
        },
        "tlc": {
          "CommentColor": [110, 118, 129],
          "KeywordColor": [255, 123, 114],
          "MacroColor": [121, 192, 255],
          "StringsColor": [165, 214, 255]
        },
        "verilog": {
          "CommentColor": [110, 118, 129],
          "KeywordColor": [255, 123, 114],
          "OperatorColor": [121, 192, 255],
          "StringColor": [165, 214, 255]
        },
        "vhdl": {
          "CommentColor": [110, 118, 129],
          "KeywordColor": [255, 123, 114],
          "OperatorColor": [121, 192, 255],
          "StringColor": [165, 214, 255]
        }
      }
    },
    "appdesigner": {
      "codeview": {
        "ReadonlyBackgroundColor": [72, 79, 88]
      }
    }
  }
}
