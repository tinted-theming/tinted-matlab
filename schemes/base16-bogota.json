{
  "ColorSchemeName": "Bogota",
  "ColorSchemeAuthor": "xscriptor (https://github.com/xscriptor)",
  "Note": "Apply this theme in Matlab using the tinted_import function, available at https://github.com/tinted-theming/tinted-matlab",

  "matlab": {
    "colors": {
      "ForegroundColor": [247, 241, 255],
      "BackgroundColor": [32, 11, 10],
      "KeywordColor": [255, 153, 153],
      "CommentColor": [82, 80, 83],
      "StringColor": [123, 216, 143],
      "UnterminatedStringColor": [176, 112, 94],
      "SystemCommandColor": [71, 230, 255],
      "SyntaxErrorColor": [252, 97, 141],
