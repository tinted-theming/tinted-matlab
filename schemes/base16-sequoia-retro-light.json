{
  "ColorSchemeName": "Sequoia Retro Light",
  "ColorSchemeAuthor": "Micheal Andreuzza (https://michaelandreuzza.com/)",
  "Note": "Apply this theme in Matlab using the tinted_import function, available at https://github.com/tinted-theming/tinted-matlab",

  "matlab": {
    "colors": {
      "ForegroundColor": [40, 41, 48],
      "BackgroundColor": [237, 238, 242],
      "KeywordColor": [191, 82, 56],
      "CommentColor": [86, 87, 96],
      "StringColor": [74, 112, 78],
      "UnterminatedStringColor": [74, 112, 78],
      "SystemCommandColor": [138, 101, 57],
      "SyntaxErrorColor": [95, 121, 130],
      "commandwindow": {
        "HyperlinkColor": [69, 106, 130],
        "ErrorColor": [95, 121, 130],
        "WarningColor": [191, 82, 56]
      },
      "programmingtools": {
        "CodeAnalyzerWarningColor": [191, 82, 56],
        "AutofixHighlightColor": [191, 82, 56],
        "VariableHighlightColor": [138, 101, 57],
        "VariablesWithSharedScopeColor": [95, 121, 130]
      }
    },
    "editor": {
