{
  "ColorSchemeName": "Lumina Dusk Light",
  "ColorSchemeAuthor": "Razik Ikhlef (https://github.com/RazikSF)",
  "Note": "Apply this theme in Matlab using the tinted_import function, available at https://github.com/tinted-theming/tinted-matlab",

  "matlab": {
    "colors": {
      "ForegroundColor": [46, 41, 69],
      "BackgroundColor": [246, 243, 254],
      "KeywordColor": [123, 70, 164],
      "CommentColor": [212, 208, 222],
      "StringColor": [53, 117, 69],
      "UnterminatedStringColor": [135, 77, 130],
      "SystemCommandColor": [0, 113, 133],
      "SyntaxErrorColor": [135, 36, 35],
      "commandwindow": {
        "HyperlinkColor": [49, 99, 173],
        "ErrorColor": [135, 36, 35],
        "WarningColor": [158, 97, 27]
      },
      "programmingtools": {
        "CodeAnalyzerWarningColor": [158, 97, 27],
        "AutofixHighlightColor": [158, 97, 27],
        "VariableHighlightColor": [0, 113, 133],
        "VariablesWithSharedScopeColor": [140, 73, 29]
      }
    },
    "editor": {
