          "PreprocessorColor": [248, 164, 97],
          "StringsColor": [144, 214, 180]
        },
        "html": {
          "AttributeNameColor": [248, 164, 97],
          "AttributeValueColor": [248, 164, 97],
          "CdataSectionColor": [120, 187, 234],
          "CharacterColor": [119, 207, 217],
          "CommentColor": [53, 49, 45],
          "DoctypeDeclarationColor": [144, 214, 180],
          "ErrorColor": [229, 167, 223],
          "OperatorColor": [212, 200, 242],
          "ProcessingInstructionColor": [144, 214, 180],
          "TagColor": [209, 99, 91]
        },
        "java": {
          "CharactersColor": [119, 207, 217],
          "CommentColor": [53, 49, 45],
          "KeywordColor": [212, 200, 242],
          "StringsColor": [144, 214, 180]
        },
        "tlc": {
          "CommentColor": [53, 49, 45],
          "KeywordColor": [212, 200, 242],
          "MacroColor": [248, 164, 97],
          "StringsColor": [144, 214, 180]
