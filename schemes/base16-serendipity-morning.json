{
  "ColorSchemeName": "Serendipity Morning",
  "ColorSchemeAuthor": "Micheal Andreuzza (https://michaelandreuzza.com/)",
  "Note": "Apply this theme in Matlab using the tinted_import function, available at https://github.com/tinted-theming/tinted-matlab",

  "matlab": {
    "colors": {
      "ForegroundColor": [63, 67, 99],
      "BackgroundColor": [246, 247, 251],
      "KeywordColor": [120, 95, 208],
      "CommentColor": [109, 114, 150],
      "StringColor": [47, 122, 171],
      "UnterminatedStringColor": [47, 122, 171],
      "SystemCommandColor": [229, 134, 120],
      "SyntaxErrorColor": [194, 90, 77],
      "commandwindow": {
        "HyperlinkColor": [98, 136, 216],
        "ErrorColor": [194, 90, 77],
        "WarningColor": [120, 95, 208]
      },
      "programmingtools": {
        "CodeAnalyzerWarningColor": [120, 95, 208],
        "AutofixHighlightColor": [120, 95, 208],
        "VariableHighlightColor": [229, 134, 120],
        "VariablesWithSharedScopeColor": [194, 90, 77]
      }
    },
    "editor": {
