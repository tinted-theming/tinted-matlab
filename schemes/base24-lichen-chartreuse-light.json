{
  "ColorSchemeName": "Lichen Chartreuse Light",
  "ColorSchemeAuthor": "Aaron Colichia (https://aaron.colichia.org/)",
  "Note": "Apply this theme in Matlab using the tinted_import function, available at https://github.com/tinted-theming/tinted-matlab",

  "matlab": {
    "colors": {
      "ForegroundColor": [45, 48, 43],
      "BackgroundColor": [245, 247, 242],
      "KeywordColor": [110, 86, 137],
      "CommentColor": [104, 113, 97],
      "StringColor": [47, 116, 98],
      "UnterminatedStringColor": [138, 79, 103],
      "SystemCommandColor": [53, 101, 105],
      "SyntaxErrorColor": [163, 71, 64],
      "commandwindow": {
        "HyperlinkColor": [53, 110, 138],
        "ErrorColor": [163, 71, 64],
        "WarningColor": [80, 107, 41]
      },
      "programmingtools": {
        "CodeAnalyzerWarningColor": [80, 107, 41],
        "AutofixHighlightColor": [80, 107, 41],
        "VariableHighlightColor": [53, 101, 105],
        "VariablesWithSharedScopeColor": [139, 93, 39]
      }
    },
