{
  "ColorSchemeName": "Lumina Cherenkov Light",
  "ColorSchemeAuthor": "Razik Ikhlef (https://github.com/RazikSF)",
  "Note": "Apply this theme in Matlab using the tinted_import function, available at https://github.com/tinted-theming/tinted-matlab",

  "matlab": {
    "colors": {
      "ForegroundColor": [30, 39, 53],
      "BackgroundColor": [242, 248, 252],
      "KeywordColor": [68, 51, 170],
      "CommentColor": [206, 214, 219],
      "StringColor": [74, 125, 38],
      "UnterminatedStringColor": [129, 74, 141],
      "SystemCommandColor": [0, 105, 123],
      "SyntaxErrorColor": [203, 63, 60],
      "commandwindow": {
        "HyperlinkColor": [44, 81, 107],
        "ErrorColor": [203, 63, 60],
        "WarningColor": [163, 95, 0]
      },
      "programmingtools": {
        "CodeAnalyzerWarningColor": [163, 95, 0],
        "AutofixHighlightColor": [163, 95, 0],
        "VariableHighlightColor": [0, 105, 123],
        "VariablesWithSharedScopeColor": [149, 71, 15]
      }
    },
    "editor": {
      "displaysettings": {
        "HighlightCurrentLineColor": [233, 242, 247],
        "linelimit": {
