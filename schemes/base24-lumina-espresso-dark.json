{
  "ColorSchemeName": "Lumina Espresso Dark",
  "ColorSchemeAuthor": "Razik Ikhlef (https://github.com/RazikSF)",
  "Note": "Apply this theme in Matlab using the tinted_import function, available at https://github.com/tinted-theming/tinted-matlab",

  "matlab": {
    "colors": {
      "ForegroundColor": [229, 223, 214],
      "BackgroundColor": [30, 21, 14],
      "KeywordColor": [199, 173, 231],
      "CommentColor": [56, 45, 36],
      "StringColor": [149, 211, 177],
      "UnterminatedStringColor": [219, 173, 214],
      "SystemCommandColor": [144, 202, 209],
      "SyntaxErrorColor": [205, 118, 110],
      "commandwindow": {
        "HyperlinkColor": [150, 191, 233],
        "ErrorColor": [205, 118, 110],
        "WarningColor": [239, 202, 134]
      },
      "programmingtools": {
        "CodeAnalyzerWarningColor": [239, 202, 134],
        "AutofixHighlightColor": [239, 202, 134],
        "VariableHighlightColor": [144, 202, 209],
        "VariablesWithSharedScopeColor": [217, 191, 166]
      }
    },
    "editor": {
      "displaysettings": {
        "HighlightCurrentLineColor": [35, 25, 17],
        "linelimit": {
          "LineColor": [45, 35, 27]
        }
      },
      "language": {
        "cpp": {
          "BadCharactersColor": [219, 173, 214],
          "CharactersColor": [144, 202, 209],
          "CommentColor": [56, 45, 36],
          "KeywordColor": [199, 173, 231],
          "PreprocessorColor": [217, 191, 166],
          "StringsColor": [149, 211, 177]
        },
        "html": {
          "AttributeNameColor": [217, 191, 166],
          "AttributeValueColor": [217, 191, 166],
          "CdataSectionColor": [150, 191, 233],
          "CharacterColor": [144, 202, 209],
          "CommentColor": [56, 45, 36],
          "DoctypeDeclarationColor": [149, 211, 177],
          "ErrorColor": [219, 173, 214],
          "OperatorColor": [199, 173, 231],
          "ProcessingInstructionColor": [149, 211, 177],
          "TagColor": [205, 118, 110]
        },
        "java": {
          "CharactersColor": [144, 202, 209],
          "CommentColor": [56, 45, 36],
          "KeywordColor": [199, 173, 231],
          "StringsColor": [149, 211, 177]
        },
        "tlc": {
          "CommentColor": [56, 45, 36],
          "KeywordColor": [199, 173, 231],
          "MacroColor": [217, 191, 166],
          "StringsColor": [149, 211, 177]
        },
        "verilog": {
          "CommentColor": [56, 45, 36],
          "KeywordColor": [199, 173, 231],
          "OperatorColor": [217, 191, 166],
          "StringColor": [149, 211, 177]
        },
        "vhdl": {
          "CommentColor": [56, 45, 36],
          "KeywordColor": [199, 173, 231],
          "OperatorColor": [217, 191, 166],
          "StringColor": [149, 211, 177]
        }
      }
    },
    "appdesigner": {
      "codeview": {
        "ReadonlyBackgroundColor": [45, 35, 27]
      }
    }
  }
}
