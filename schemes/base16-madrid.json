          "CharacterColor": [0, 122, 158],
          "CommentColor": [77, 77, 77],
          "DoctypeDeclarationColor": [0, 122, 40],
          "ErrorColor": [102, 35, 16],
          "OperatorColor": [77, 38, 153],
          "ProcessingInstructionColor": [0, 122, 40],
          "TagColor": [153, 0, 38]
        },
        "java": {
          "CharactersColor": [0, 122, 158],
          "CommentColor": [77, 77, 77],
          "KeywordColor": [77, 38, 153],
          "StringsColor": [0, 122, 40]
        },
        "tlc": {
          "CommentColor": [77, 77, 77],
          "KeywordColor": [77, 38, 153],
