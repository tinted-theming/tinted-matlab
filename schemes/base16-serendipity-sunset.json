{
  "ColorSchemeName": "Serendipity Sunset",
  "ColorSchemeAuthor": "Micheal Andreuzza (https://michaelandreuzza.com/)",
  "Note": "Apply this theme in Matlab using the tinted_import function, available at https://github.com/tinted-theming/tinted-matlab",

  "matlab": {
    "colors": {
      "ForegroundColor": [222, 224, 239],
      "BackgroundColor": [32, 34, 49],
      "KeywordColor": [163, 146, 220],
      "CommentColor": [141, 143, 158],
      "StringColor": [112, 155, 189],
      "UnterminatedStringColor": [112, 155, 189],
      "SystemCommandColor": [214, 180, 180],
      "SyntaxErrorColor": [209, 145, 143],
      "commandwindow": {
        "HyperlinkColor": [160, 182, 232],
        "ErrorColor": [209, 145, 143],
        "WarningColor": [163, 146, 220]
      },
      "programmingtools": {
        "CodeAnalyzerWarningColor": [163, 146, 220],
        "AutofixHighlightColor": [163, 146, 220],
        "VariableHighlightColor": [214, 180, 180],
        "VariablesWithSharedScopeColor": [209, 145, 143]
      }
    },
    "editor": {
      "displaysettings": {
        "HighlightCurrentLineColor": [39, 41, 56],
        "linelimit": {
