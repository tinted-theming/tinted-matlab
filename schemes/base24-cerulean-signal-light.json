          "CharacterColor": [0, 114, 126],
          "CommentColor": [99, 114, 135],
          "DoctypeDeclarationColor": [23, 121, 94],
          "ErrorColor": [122, 78, 60],
          "OperatorColor": [160, 0, 125],
          "ProcessingInstructionColor": [23, 121, 94],
          "TagColor": [180, 35, 61]
        },
        "java": {
          "CharactersColor": [0, 114, 126],
          "CommentColor": [99, 114, 135],
          "KeywordColor": [160, 0, 125],
          "StringsColor": [23, 121, 94]
