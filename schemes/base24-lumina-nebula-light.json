          "CharacterColor": [0, 101, 126],
          "CommentColor": [211, 213, 218],
          "DoctypeDeclarationColor": [46, 114, 65],
          "ErrorColor": [132, 72, 127],
          "OperatorColor": [108, 77, 158],
          "ProcessingInstructionColor": [46, 114, 65],
          "TagColor": [144, 39, 37]
        },
        "java": {
          "CharactersColor": [0, 101, 126],
          "CommentColor": [211, 213, 218],
          "KeywordColor": [108, 77, 158],
          "StringsColor": [46, 114, 65]
