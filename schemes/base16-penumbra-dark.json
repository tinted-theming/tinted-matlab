          "DoctypeDeclarationColor": [79, 145, 88],
          "ErrorColor": [156, 103, 161],
          "OperatorColor": [113, 118, 174],
          "ProcessingInstructionColor": [79, 145, 88],
          "TagColor": [186, 97, 106]
        },
        "java": {
          "CharactersColor": [0, 137, 134],
          "CommentColor": [94, 96, 99],
          "KeywordColor": [113, 118, 174],
          "StringsColor": [79, 145, 88]
