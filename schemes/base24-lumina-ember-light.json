{
  "ColorSchemeName": "Lumina Ember Light",
  "ColorSchemeAuthor": "Razik Ikhlef (https://github.com/RazikSF)",
  "Note": "Apply this theme in Matlab using the tinted_import function, available at https://github.com/tinted-theming/tinted-matlab",

  "matlab": {
    "colors": {
      "ForegroundColor": [55, 43, 30],
      "BackgroundColor": [249, 244, 234],
      "KeywordColor": [101, 89, 161],
      "CommentColor": [216, 209, 196],
      "StringColor": [67, 115, 41],
      "UnterminatedStringColor": [150, 67, 123],
      "SystemCommandColor": [0, 114, 133],
      "SyntaxErrorColor": [129, 29, 29],
      "commandwindow": {
        "HyperlinkColor": [37, 107, 153],
        "ErrorColor": [129, 29, 29],
        "WarningColor": [160, 97, 22]
      },
      "programmingtools": {
        "CodeAnalyzerWarningColor": [160, 97, 22],
        "AutofixHighlightColor": [160, 97, 22],
        "VariableHighlightColor": [0, 114, 133],
        "VariablesWithSharedScopeColor": [134, 67, 21]
      }
    },
    "editor": {
      "displaysettings": {
        "HighlightCurrentLineColor": [244, 237, 223],
        "linelimit": {
          "LineColor": [233, 226, 212]
        }
      },
      "language": {
        "cpp": {
          "BadCharactersColor": [150, 67, 123],
          "CharactersColor": [0, 114, 133],
          "CommentColor": [216, 209, 196],
          "KeywordColor": [101, 89, 161],
          "PreprocessorColor": [134, 67, 21],
          "StringsColor": [67, 115, 41]
        },
        "html": {
          "AttributeNameColor": [134, 67, 21],
          "AttributeValueColor": [134, 67, 21],
          "CdataSectionColor": [37, 107, 153],
          "CharacterColor": [0, 114, 133],
          "CommentColor": [216, 209, 196],
          "DoctypeDeclarationColor": [67, 115, 41],
          "ErrorColor": [150, 67, 123],
          "OperatorColor": [101, 89, 161],
          "ProcessingInstructionColor": [67, 115, 41],
          "TagColor": [129, 29, 29]
        },
        "java": {
          "CharactersColor": [0, 114, 133],
          "CommentColor": [216, 209, 196],
          "KeywordColor": [101, 89, 161],
          "StringsColor": [67, 115, 41]
        },
        "tlc": {
          "CommentColor": [216, 209, 196],
          "KeywordColor": [101, 89, 161],
          "MacroColor": [134, 67, 21],
          "StringsColor": [67, 115, 41]
        },
        "verilog": {
          "CommentColor": [216, 209, 196],
          "KeywordColor": [101, 89, 161],
          "OperatorColor": [134, 67, 21],
          "StringColor": [67, 115, 41]
        },
        "vhdl": {
          "CommentColor": [216, 209, 196],
          "KeywordColor": [101, 89, 161],
          "OperatorColor": [134, 67, 21],
          "StringColor": [67, 115, 41]
        }
      }
    },
    "appdesigner": {
      "codeview": {
        "ReadonlyBackgroundColor": [233, 226, 212]
      }
    }
  }
}
