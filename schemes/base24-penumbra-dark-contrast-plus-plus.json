          "AttributeValueColor": [216, 143, 76],
          "CdataSectionColor": [0, 158, 219],
          "CharacterColor": [0, 168, 164],
          "CommentColor": [87, 91, 98],
          "DoctypeDeclarationColor": [98, 176, 108],
          "ErrorColor": [190, 127, 196],
          "OperatorColor": [138, 144, 212],
          "ProcessingInstructionColor": [98, 176, 108],
          "TagColor": [225, 119, 130]
        },
        "java": {
          "CharactersColor": [0, 168, 164],
          "CommentColor": [87, 91, 98],
          "KeywordColor": [138, 144, 212],
          "StringsColor": [98, 176, 108]
        },
        "tlc": {
          "CommentColor": [87, 91, 98],
          "KeywordColor": [138, 144, 212],
          "MacroColor": [216, 143, 76],
          "StringsColor": [98, 176, 108]
