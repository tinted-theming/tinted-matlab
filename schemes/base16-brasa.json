{
  "ColorSchemeName": "Brasa",
  "ColorSchemeAuthor": "Teshre",
  "Note": "Apply this theme in Matlab using the tinted_import function, available at https://github.com/tinted-theming/tinted-matlab",

  "matlab": {
    "colors": {
      "ForegroundColor": [240, 216, 192],
      "BackgroundColor": [26, 15, 10],
      "KeywordColor": [230, 138, 162],
      "CommentColor": [122, 97, 80],
      "StringColor": [184, 194, 74],
      "UnterminatedStringColor": [90, 58, 40],
      "SystemCommandColor": [107, 200, 184],
      "SyntaxErrorColor": [242, 104, 90],
      "commandwindow": {
        "HyperlinkColor": [154, 166, 224],
        "ErrorColor": [242, 104, 90],
        "WarningColor": [240, 178, 58]
      },
      "programmingtools": {
        "CodeAnalyzerWarningColor": [240, 178, 58],
