          "CommentColor": [70, 87, 128],
          "DoctypeDeclarationColor": [163, 190, 140],
          "ErrorColor": [191, 136, 188],
          "OperatorColor": [180, 142, 173],
          "ProcessingInstructionColor": [163, 190, 140],
          "TagColor": [191, 97, 106]
        },
        "java": {
          "CharactersColor": [136, 192, 208],
          "CommentColor": [70, 87, 128],
          "KeywordColor": [180, 142, 173],
          "StringsColor": [163, 190, 140]
        },
        "tlc": {
