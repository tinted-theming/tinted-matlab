{
  "ColorSchemeName": "Lumina Espresso Dark",
  "ColorSchemeAuthor": "Razik Ikhlef (https://github.com/RazikSF)",
  "Note": "Apply this theme in Matlab using the tinted_import function, available at https://github.com/tinted-theming/tinted-matlab",

  "matlab": {
    "colors": {
      "ForegroundColor": [229, 219, 205],
      "BackgroundColor": [47, 29, 17],
      "KeywordColor": [182, 175, 232],
      "CommentColor": [75, 53, 39],
      "StringColor": [146, 199, 156],
      "UnterminatedStringColor": [220, 142, 187],
      "SystemCommandColor": [183, 220, 229],
      "SyntaxErrorColor": [212, 113, 105],
      "commandwindow": {
        "HyperlinkColor": [146, 187, 234],
        "ErrorColor": [212, 113, 105],
        "WarningColor": [253, 207, 144]
      },
      "programmingtools": {
        "CodeAnalyzerWarningColor": [253, 207, 144],
        "AutofixHighlightColor": [253, 207, 144],
        "VariableHighlightColor": [183, 220, 229],
        "VariablesWithSharedScopeColor": [255, 190, 146]
      }
    },
    "editor": {
