{
  "ColorSchemeName": "Cerulean Signal Light",
  "ColorSchemeAuthor": "Aaron Colichia (https://aaron.colichia.org/)",
  "Note": "Apply this theme in Matlab using the tinted_import function, available at https://github.com/tinted-theming/tinted-matlab",

  "matlab": {
    "colors": {
      "ForegroundColor": [35, 43, 56],
      "BackgroundColor": [247, 249, 252],
      "KeywordColor": [160, 0, 125],
      "CommentColor": [99, 114, 135],
      "StringColor": [23, 121, 94],
      "UnterminatedStringColor": [122, 78, 60],
      "SystemCommandColor": [0, 114, 126],
      "SyntaxErrorColor": [180, 35, 61],
      "commandwindow": {
        "HyperlinkColor": [0, 111, 168],
        "ErrorColor": [180, 35, 61],
        "WarningColor": [111, 99, 0]
      },
      "programmingtools": {
        "CodeAnalyzerWarningColor": [111, 99, 0],
        "AutofixHighlightColor": [111, 99, 0],
        "VariableHighlightColor": [0, 114, 126],
        "VariablesWithSharedScopeColor": [154, 79, 0]
      }
    },
    "editor": {
