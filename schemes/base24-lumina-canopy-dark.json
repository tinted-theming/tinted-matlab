{
  "ColorSchemeName": "Lumina Canopy Dark",
  "ColorSchemeAuthor": "Razik Ikhlef (https://github.com/RazikSF)",
  "Note": "Apply this theme in Matlab using the tinted_import function, available at https://github.com/tinted-theming/tinted-matlab",

  "matlab": {
    "colors": {
      "ForegroundColor": [205, 219, 208],
      "BackgroundColor": [19, 29, 22],
      "KeywordColor": [193, 184, 252],
      "CommentColor": [42, 54, 45],
      "StringColor": [150, 212, 162],
      "UnterminatedStringColor": [209, 165, 211],
      "SystemCommandColor": [140, 227, 221],
      "SyntaxErrorColor": [211, 102, 94],
      "commandwindow": {
        "HyperlinkColor": [141, 198, 255],
        "ErrorColor": [211, 102, 94],
        "WarningColor": [242, 187, 49]
      },
      "programmingtools": {
        "CodeAnalyzerWarningColor": [242, 187, 49],
        "AutofixHighlightColor": [242, 187, 49],
        "VariableHighlightColor": [140, 227, 221],
        "VariablesWithSharedScopeColor": [253, 173, 118]
      }
    },
    "editor": {
      "displaysettings": {
        "HighlightCurrentLineColor": [23, 34, 26],
        "linelimit": {
          "LineColor": [32, 44, 36]
        }
      },
      "language": {
        "cpp": {
          "BadCharactersColor": [209, 165, 211],
          "CharactersColor": [140, 227, 221],
          "CommentColor": [42, 54, 45],
          "KeywordColor": [193, 184, 252],
          "PreprocessorColor": [253, 173, 118],
          "StringsColor": [150, 212, 162]
        },
        "html": {
          "AttributeNameColor": [253, 173, 118],
          "AttributeValueColor": [253, 173, 118],
          "CdataSectionColor": [141, 198, 255],
          "CharacterColor": [140, 227, 221],
          "CommentColor": [42, 54, 45],
          "DoctypeDeclarationColor": [150, 212, 162],
          "ErrorColor": [209, 165, 211],
          "OperatorColor": [193, 184, 252],
          "ProcessingInstructionColor": [150, 212, 162],
          "TagColor": [211, 102, 94]
        },
        "java": {
          "CharactersColor": [140, 227, 221],
          "CommentColor": [42, 54, 45],
          "KeywordColor": [193, 184, 252],
          "StringsColor": [150, 212, 162]
        },
        "tlc": {
          "CommentColor": [42, 54, 45],
          "KeywordColor": [193, 184, 252],
          "MacroColor": [253, 173, 118],
          "StringsColor": [150, 212, 162]
        },
        "verilog": {
          "CommentColor": [42, 54, 45],
          "KeywordColor": [193, 184, 252],
          "OperatorColor": [253, 173, 118],
          "StringColor": [150, 212, 162]
        },
        "vhdl": {
          "CommentColor": [42, 54, 45],
          "KeywordColor": [193, 184, 252],
          "OperatorColor": [253, 173, 118],
          "StringColor": [150, 212, 162]
        }
      }
    },
    "appdesigner": {
      "codeview": {
        "ReadonlyBackgroundColor": [32, 44, 36]
      }
    }
  }
}
