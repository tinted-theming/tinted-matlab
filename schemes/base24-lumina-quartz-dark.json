{
  "ColorSchemeName": "Lumina Quartz Dark",
  "ColorSchemeAuthor": "Razik Ikhlef (https://github.com/RazikSF)",
  "Note": "Apply this theme in Matlab using the tinted_import function, available at https://github.com/tinted-theming/tinted-matlab",

  "matlab": {
    "colors": {
      "ForegroundColor": [204, 208, 211],
      "BackgroundColor": [22, 23, 25],
      "KeywordColor": [203, 180, 239],
      "CommentColor": [46, 47, 49],
      "StringColor": [157, 215, 183],
      "UnterminatedStringColor": [228, 189, 223],
      "SystemCommandColor": [168, 213, 219],
      "SyntaxErrorColor": [197, 124, 116],
      "commandwindow": {
        "HyperlinkColor": [182, 206, 237],
        "ErrorColor": [197, 124, 116],
        "WarningColor": [223, 207, 176]
      },
      "programmingtools": {
        "CodeAnalyzerWarningColor": [223, 207, 176],
        "AutofixHighlightColor": [223, 207, 176],
        "VariableHighlightColor": [168, 213, 219],
        "VariablesWithSharedScopeColor": [246, 190, 154]
      }
    },
    "editor": {
      "displaysettings": {
        "HighlightCurrentLineColor": [26, 28, 30],
        "linelimit": {
          "LineColor": [36, 37, 39]
        }
      },
      "language": {
        "cpp": {
          "BadCharactersColor": [228, 189, 223],
          "CharactersColor": [168, 213, 219],
          "CommentColor": [46, 47, 49],
          "KeywordColor": [203, 180, 239],
          "PreprocessorColor": [246, 190, 154],
          "StringsColor": [157, 215, 183]
        },
        "html": {
          "AttributeNameColor": [246, 190, 154],
          "AttributeValueColor": [246, 190, 154],
          "CdataSectionColor": [182, 206, 237],
          "CharacterColor": [168, 213, 219],
          "CommentColor": [46, 47, 49],
          "DoctypeDeclarationColor": [157, 215, 183],
          "ErrorColor": [228, 189, 223],
          "OperatorColor": [203, 180, 239],
          "ProcessingInstructionColor": [157, 215, 183],
          "TagColor": [197, 124, 116]
        },
        "java": {
          "CharactersColor": [168, 213, 219],
          "CommentColor": [46, 47, 49],
          "KeywordColor": [203, 180, 239],
          "StringsColor": [157, 215, 183]
        },
        "tlc": {
          "CommentColor": [46, 47, 49],
          "KeywordColor": [203, 180, 239],
          "MacroColor": [246, 190, 154],
          "StringsColor": [157, 215, 183]
        },
        "verilog": {
          "CommentColor": [46, 47, 49],
          "KeywordColor": [203, 180, 239],
          "OperatorColor": [246, 190, 154],
          "StringColor": [157, 215, 183]
        },
        "vhdl": {
          "CommentColor": [46, 47, 49],
          "KeywordColor": [203, 180, 239],
          "OperatorColor": [246, 190, 154],
          "StringColor": [157, 215, 183]
        }
      }
    },
    "appdesigner": {
      "codeview": {
        "ReadonlyBackgroundColor": [36, 37, 39]
      }
    }
  }
}
