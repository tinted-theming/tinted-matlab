          "ErrorColor": [212, 163, 220],
          "OperatorColor": [188, 181, 238],
          "ProcessingInstructionColor": [146, 211, 185],
          "TagColor": [212, 113, 105]
        },
        "java": {
          "CharactersColor": [133, 203, 211],
          "CommentColor": [68, 58, 45],
          "KeywordColor": [188, 181, 238],
          "StringsColor": [146, 211, 185]
