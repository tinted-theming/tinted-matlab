          "AttributeValueColor": [149, 71, 15],
          "CdataSectionColor": [44, 81, 107],
          "CharacterColor": [0, 105, 123],
          "CommentColor": [206, 214, 219],
          "DoctypeDeclarationColor": [74, 125, 38],
          "ErrorColor": [129, 74, 141],
          "OperatorColor": [68, 51, 170],
          "ProcessingInstructionColor": [74, 125, 38],
          "TagColor": [203, 63, 60]
        },
        "java": {
          "CharactersColor": [0, 105, 123],
          "CommentColor": [206, 214, 219],
          "KeywordColor": [68, 51, 170],
          "StringsColor": [74, 125, 38]
        },
        "tlc": {
          "CommentColor": [206, 214, 219],
          "KeywordColor": [68, 51, 170],
