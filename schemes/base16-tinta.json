{
  "ColorSchemeName": "Tinta",
  "ColorSchemeAuthor": "Teshre",
  "Note": "Apply this theme in Matlab using the tinted_import function, available at https://github.com/tinted-theming/tinted-matlab",

  "matlab": {
    "colors": {
      "ForegroundColor": [216, 214, 208],
      "BackgroundColor": [16, 16, 18],
      "KeywordColor": [176, 160, 184],
      "CommentColor": [98, 98, 106],
      "StringColor": [154, 168, 144],
      "UnterminatedStringColor": [74, 74, 80],
      "SystemCommandColor": [128, 184, 180],
      "SyntaxErrorColor": [208, 114, 106],
