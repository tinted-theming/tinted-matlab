{
  "ColorSchemeName": "Lumina Ember Dark",
  "ColorSchemeAuthor": "Razik Ikhlef (https://github.com/RazikSF)",
  "Note": "Apply this theme in Matlab using the tinted_import function, available at https://github.com/tinted-theming/tinted-matlab",

  "matlab": {
    "colors": {
      "ForegroundColor": [228, 221, 208],
      "BackgroundColor": [23, 21, 17],
      "KeywordColor": [187, 181, 227],
      "CommentColor": [47, 45, 40],
      "StringColor": [169, 204, 151],
      "UnterminatedStringColor": [215, 162, 198],
      "SystemCommandColor": [145, 199, 205],
      "SyntaxErrorColor": [203, 120, 112],
      "commandwindow": {
        "HyperlinkColor": [148, 190, 220],
        "ErrorColor": [203, 120, 112],
        "WarningColor": [229, 204, 136]
      },
      "programmingtools": {
        "CodeAnalyzerWarningColor": [229, 204, 136],
        "AutofixHighlightColor": [229, 204, 136],
        "VariableHighlightColor": [145, 199, 205],
        "VariablesWithSharedScopeColor": [229, 155, 124]
      }
    },
    "editor": {
      "displaysettings": {
        "HighlightCurrentLineColor": [28, 26, 21],
        "linelimit": {
          "LineColor": [37, 35, 30]
        }
      },
      "language": {
        "cpp": {
          "BadCharactersColor": [215, 162, 198],
          "CharactersColor": [145, 199, 205],
          "CommentColor": [47, 45, 40],
          "KeywordColor": [187, 181, 227],
          "PreprocessorColor": [229, 155, 124],
          "StringsColor": [169, 204, 151]
        },
        "html": {
          "AttributeNameColor": [229, 155, 124],
          "AttributeValueColor": [229, 155, 124],
          "CdataSectionColor": [148, 190, 220],
          "CharacterColor": [145, 199, 205],
          "CommentColor": [47, 45, 40],
          "DoctypeDeclarationColor": [169, 204, 151],
          "ErrorColor": [215, 162, 198],
          "OperatorColor": [187, 181, 227],
          "ProcessingInstructionColor": [169, 204, 151],
          "TagColor": [203, 120, 112]
        },
        "java": {
          "CharactersColor": [145, 199, 205],
          "CommentColor": [47, 45, 40],
          "KeywordColor": [187, 181, 227],
          "StringsColor": [169, 204, 151]
        },
        "tlc": {
          "CommentColor": [47, 45, 40],
          "KeywordColor": [187, 181, 227],
          "MacroColor": [229, 155, 124],
          "StringsColor": [169, 204, 151]
        },
        "verilog": {
          "CommentColor": [47, 45, 40],
          "KeywordColor": [187, 181, 227],
          "OperatorColor": [229, 155, 124],
          "StringColor": [169, 204, 151]
        },
        "vhdl": {
          "CommentColor": [47, 45, 40],
          "KeywordColor": [187, 181, 227],
          "OperatorColor": [229, 155, 124],
          "StringColor": [169, 204, 151]
        }
      }
    },
    "appdesigner": {
      "codeview": {
        "ReadonlyBackgroundColor": [37, 35, 30]
      }
    }
  }
}
