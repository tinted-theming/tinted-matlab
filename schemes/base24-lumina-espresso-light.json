        "verilog": {
          "CommentColor": [217, 206, 194],
          "KeywordColor": [112, 73, 161],
          "OperatorColor": [137, 70, 26],
          "StringColor": [21, 116, 77]
        },
        "vhdl": {
          "CommentColor": [217, 206, 194],
          "KeywordColor": [112, 73, 161],
          "OperatorColor": [137, 70, 26],
          "StringColor": [21, 116, 77]
        }
      }
    },
    "appdesigner": {
      "codeview": {
        "ReadonlyBackgroundColor": [233, 222, 210]
      }
    }
