{
  "ColorSchemeName": "Lumina Canopy Light",
  "ColorSchemeAuthor": "Razik Ikhlef (https://github.com/RazikSF)",
  "Note": "Apply this theme in Matlab using the tinted_import function, available at https://github.com/tinted-theming/tinted-matlab",

  "matlab": {
    "colors": {
      "ForegroundColor": [30, 51, 35],
      "BackgroundColor": [241, 249, 239],
      "KeywordColor": [101, 89, 158],
      "CommentColor": [205, 215, 203],
      "StringColor": [51, 117, 69],
      "UnterminatedStringColor": [134, 76, 130],
      "SystemCommandColor": [0, 113, 132],
      "SyntaxErrorColor": [134, 12, 44],
      "commandwindow": {
        "HyperlinkColor": [4, 106, 167],
        "ErrorColor": [134, 12, 44],
        "WarningColor": [144, 87, 5]
      },
      "programmingtools": {
        "CodeAnalyzerWarningColor": [144, 87, 5],
        "AutofixHighlightColor": [144, 87, 5],
        "VariableHighlightColor": [0, 113, 132],
        "VariablesWithSharedScopeColor": [123, 60, 18]
      }
    },
    "editor": {
      "displaysettings": {
        "HighlightCurrentLineColor": [233, 243, 230],
        "linelimit": {
          "LineColor": [221, 232, 219]
        }
      },
      "language": {
        "cpp": {
          "BadCharactersColor": [134, 76, 130],
          "CharactersColor": [0, 113, 132],
          "CommentColor": [205, 215, 203],
          "KeywordColor": [101, 89, 158],
          "PreprocessorColor": [123, 60, 18],
          "StringsColor": [51, 117, 69]
        },
        "html": {
          "AttributeNameColor": [123, 60, 18],
          "AttributeValueColor": [123, 60, 18],
          "CdataSectionColor": [4, 106, 167],
          "CharacterColor": [0, 113, 132],
          "CommentColor": [205, 215, 203],
          "DoctypeDeclarationColor": [51, 117, 69],
          "ErrorColor": [134, 76, 130],
          "OperatorColor": [101, 89, 158],
          "ProcessingInstructionColor": [51, 117, 69],
          "TagColor": [134, 12, 44]
        },
        "java": {
          "CharactersColor": [0, 113, 132],
          "CommentColor": [205, 215, 203],
          "KeywordColor": [101, 89, 158],
          "StringsColor": [51, 117, 69]
        },
        "tlc": {
          "CommentColor": [205, 215, 203],
          "KeywordColor": [101, 89, 158],
          "MacroColor": [123, 60, 18],
          "StringsColor": [51, 117, 69]
        },
        "verilog": {
          "CommentColor": [205, 215, 203],
          "KeywordColor": [101, 89, 158],
          "OperatorColor": [123, 60, 18],
          "StringColor": [51, 117, 69]
        },
        "vhdl": {
          "CommentColor": [205, 215, 203],
          "KeywordColor": [101, 89, 158],
          "OperatorColor": [123, 60, 18],
          "StringColor": [51, 117, 69]
        }
      }
    },
    "appdesigner": {
      "codeview": {
        "ReadonlyBackgroundColor": [221, 232, 219]
      }
    }
  }
}
