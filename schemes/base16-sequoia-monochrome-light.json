          "CommentColor": [157, 162, 173],
          "DoctypeDeclarationColor": [46, 48, 56],
          "ErrorColor": [46, 48, 56],
          "OperatorColor": [80, 83, 94],
          "ProcessingInstructionColor": [46, 48, 56],
          "TagColor": [82, 86, 102]
        },
        "java": {
          "CharactersColor": [69, 71, 82],
          "CommentColor": [157, 162, 173],
          "KeywordColor": [80, 83, 94],
          "StringsColor": [46, 48, 56]
