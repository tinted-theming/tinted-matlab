          "AttributeValueColor": [135, 76, 42],
          "CdataSectionColor": [68, 104, 148],
          "CharacterColor": [0, 112, 146],
          "CommentColor": [210, 212, 217],
          "DoctypeDeclarationColor": [33, 117, 80],
          "ErrorColor": [130, 82, 126],
          "OperatorColor": [118, 83, 165],
          "ProcessingInstructionColor": [33, 117, 80],
          "TagColor": [125, 43, 40]
        },
        "java": {
          "CharactersColor": [0, 112, 146],
          "CommentColor": [210, 212, 217],
          "KeywordColor": [118, 83, 165],
          "StringsColor": [33, 117, 80]
        },
        "tlc": {
          "CommentColor": [210, 212, 217],
          "KeywordColor": [118, 83, 165],
