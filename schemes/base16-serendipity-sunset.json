          "PreprocessorColor": [209, 145, 143],
          "StringsColor": [112, 155, 189]
        },
        "html": {
          "AttributeNameColor": [209, 145, 143],
          "AttributeValueColor": [209, 145, 143],
          "CdataSectionColor": [160, 182, 232],
          "CharacterColor": [214, 180, 180],
          "CommentColor": [141, 143, 158],
          "DoctypeDeclarationColor": [112, 155, 189],
          "ErrorColor": [112, 155, 189],
          "OperatorColor": [163, 146, 220],
          "ProcessingInstructionColor": [112, 155, 189],
          "TagColor": [209, 145, 143]
        },
        "java": {
          "CharactersColor": [214, 180, 180],
          "CommentColor": [141, 143, 158],
          "KeywordColor": [163, 146, 220],
          "StringsColor": [112, 155, 189]
        },
        "tlc": {
          "CommentColor": [141, 143, 158],
          "KeywordColor": [163, 146, 220],
          "MacroColor": [209, 145, 143],
          "StringsColor": [112, 155, 189]
