{
  "ColorSchemeName": "Lahabana",
  "ColorSchemeAuthor": "xscriptor (https://github.com/xscriptor)",
  "Note": "Apply this theme in Matlab using the tinted_import function, available at https://github.com/tinted-theming/tinted-matlab",

  "matlab": {
    "colors": {
      "ForegroundColor": [247, 241, 255],
      "BackgroundColor": [25, 25, 26],
      "KeywordColor": [148, 138, 227],
      "CommentColor": [118, 116, 122],
      "StringColor": [123, 216, 143],
      "UnterminatedStringColor": [165, 123, 106],
      "SystemCommandColor": [90, 212, 230],
      "SyntaxErrorColor": [252, 97, 141],
      "commandwindow": {
