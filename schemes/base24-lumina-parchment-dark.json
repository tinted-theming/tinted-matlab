{
  "ColorSchemeName": "Lumina Parchment Dark",
  "ColorSchemeAuthor": "Razik Ikhlef (https://github.com/RazikSF)",
  "Note": "Apply this theme in Matlab using the tinted_import function, available at https://github.com/tinted-theming/tinted-matlab",

  "matlab": {
    "colors": {
      "ForegroundColor": [239, 229, 208],
      "BackgroundColor": [42, 33, 22],
      "KeywordColor": [188, 181, 238],
      "CommentColor": [68, 58, 45],
      "StringColor": [146, 211, 185],
      "UnterminatedStringColor": [212, 163, 220],
      "SystemCommandColor": [133, 203, 211],
      "SyntaxErrorColor": [212, 113, 105],
      "commandwindow": {
        "HyperlinkColor": [151, 189, 244],
        "ErrorColor": [212, 113, 105],
        "WarningColor": [224, 186, 106]
      },
      "programmingtools": {
        "CodeAnalyzerWarningColor": [224, 186, 106],
        "AutofixHighlightColor": [224, 186, 106],
        "VariableHighlightColor": [133, 203, 211],
        "VariablesWithSharedScopeColor": [255, 189, 144]
      }
    },
    "editor": {
