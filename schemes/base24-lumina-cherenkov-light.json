{
  "ColorSchemeName": "Lumina Cherenkov Light",
  "ColorSchemeAuthor": "Razik Ikhlef (https://github.com/RazikSF)",
  "Note": "Apply this theme in Matlab using the tinted_import function, available at https://github.com/tinted-theming/tinted-matlab",

  "matlab": {
    "colors": {
      "ForegroundColor": [31, 46, 83],
      "BackgroundColor": [245, 248, 255],
      "KeywordColor": [120, 73, 193],
      "CommentColor": [209, 213, 223],
      "StringColor": [34, 122, 62],
      "UnterminatedStringColor": [144, 71, 138],
      "SystemCommandColor": [8, 113, 129],
      "SyntaxErrorColor": [163, 34, 36],
      "commandwindow": {
        "HyperlinkColor": [10, 79, 204],
        "ErrorColor": [163, 34, 36],
        "WarningColor": [163, 95, 0]
      },
      "programmingtools": {
        "CodeAnalyzerWarningColor": [163, 95, 0],
        "AutofixHighlightColor": [163, 95, 0],
        "VariableHighlightColor": [8, 113, 129],
        "VariablesWithSharedScopeColor": [181, 74, 4]
      }
    },
    "editor": {
      "displaysettings": {
        "HighlightCurrentLineColor": [237, 241, 251],
        "linelimit": {
          "LineColor": [226, 230, 239]
        }
      },
      "language": {
        "cpp": {
          "BadCharactersColor": [144, 71, 138],
          "CharactersColor": [8, 113, 129],
          "CommentColor": [209, 213, 223],
          "KeywordColor": [120, 73, 193],
          "PreprocessorColor": [181, 74, 4],
          "StringsColor": [34, 122, 62]
        },
        "html": {
          "AttributeNameColor": [181, 74, 4],
          "AttributeValueColor": [181, 74, 4],
          "CdataSectionColor": [10, 79, 204],
          "CharacterColor": [8, 113, 129],
          "CommentColor": [209, 213, 223],
          "DoctypeDeclarationColor": [34, 122, 62],
          "ErrorColor": [144, 71, 138],
          "OperatorColor": [120, 73, 193],
          "ProcessingInstructionColor": [34, 122, 62],
          "TagColor": [163, 34, 36]
        },
        "java": {
          "CharactersColor": [8, 113, 129],
          "CommentColor": [209, 213, 223],
          "KeywordColor": [120, 73, 193],
          "StringsColor": [34, 122, 62]
        },
        "tlc": {
          "CommentColor": [209, 213, 223],
          "KeywordColor": [120, 73, 193],
          "MacroColor": [181, 74, 4],
          "StringsColor": [34, 122, 62]
        },
        "verilog": {
          "CommentColor": [209, 213, 223],
          "KeywordColor": [120, 73, 193],
          "OperatorColor": [181, 74, 4],
          "StringColor": [34, 122, 62]
        },
        "vhdl": {
          "CommentColor": [209, 213, 223],
          "KeywordColor": [120, 73, 193],
          "OperatorColor": [181, 74, 4],
          "StringColor": [34, 122, 62]
        }
      }
    },
    "appdesigner": {
      "codeview": {
        "ReadonlyBackgroundColor": [226, 230, 239]
      }
    }
