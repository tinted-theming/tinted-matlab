{
  "ColorSchemeName": "Lumina Canopy Light",
  "ColorSchemeAuthor": "Razik Ikhlef (https://github.com/RazikSF)",
  "Note": "Apply this theme in Matlab using the tinted_import function, available at https://github.com/tinted-theming/tinted-matlab",

  "matlab": {
    "colors": {
      "ForegroundColor": [59, 67, 58],
      "BackgroundColor": [241, 245, 240],
      "KeywordColor": [115, 96, 184],
      "CommentColor": [206, 211, 204],
      "StringColor": [0, 121, 83],
      "UnterminatedStringColor": [158, 50, 125],
      "SystemCommandColor": [0, 112, 131],
      "SyntaxErrorColor": [156, 46, 44],
      "commandwindow": {
        "HyperlinkColor": [29, 92, 153],
        "ErrorColor": [156, 46, 44],
        "WarningColor": [160, 97, 21]
      },
      "programmingtools": {
        "CodeAnalyzerWarningColor": [160, 97, 21],
        "AutofixHighlightColor": [160, 97, 21],
        "VariableHighlightColor": [0, 112, 131],
        "VariablesWithSharedScopeColor": [156, 82, 36]
      }
    },
    "editor": {
