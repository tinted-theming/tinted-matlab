          "CharacterColor": [4, 104, 113],
          "CommentColor": [218, 210, 198],
          "DoctypeDeclarationColor": [25, 120, 77],
          "ErrorColor": [139, 73, 154],
          "OperatorColor": [103, 88, 168],
          "ProcessingInstructionColor": [25, 120, 77],
          "TagColor": [140, 28, 29]
        },
        "java": {
          "CharactersColor": [4, 104, 113],
          "CommentColor": [218, 210, 198],
          "KeywordColor": [103, 88, 168],
          "StringsColor": [25, 120, 77]
