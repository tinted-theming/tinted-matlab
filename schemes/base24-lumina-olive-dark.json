{
  "ColorSchemeName": "Lumina Olive Dark",
  "ColorSchemeAuthor": "Razik Ikhlef (https://github.com/RazikSF)",
  "Note": "Apply this theme in Matlab using the tinted_import function, available at https://github.com/tinted-theming/tinted-matlab",

  "matlab": {
    "colors": {
      "ForegroundColor": [225, 223, 206],
      "BackgroundColor": [26, 27, 12],
      "KeywordColor": [192, 186, 242],
      "CommentColor": [50, 52, 34],
      "StringColor": [181, 213, 198],
      "UnterminatedStringColor": [213, 162, 208],
      "SystemCommandColor": [139, 207, 215],
      "SyntaxErrorColor": [211, 114, 106],
      "commandwindow": {
        "HyperlinkColor": [162, 196, 240],
        "ErrorColor": [211, 114, 106],
        "WarningColor": [235, 194, 124]
      },
      "programmingtools": {
        "CodeAnalyzerWarningColor": [235, 194, 124],
        "AutofixHighlightColor": [235, 194, 124],
        "VariableHighlightColor": [139, 207, 215],
        "VariablesWithSharedScopeColor": [255, 195, 155]
      }
    },
    "editor": {
      "displaysettings": {
        "HighlightCurrentLineColor": [31, 32, 15],
        "linelimit": {
          "LineColor": [40, 41, 24]
        }
      },
      "language": {
        "cpp": {
          "BadCharactersColor": [213, 162, 208],
          "CharactersColor": [139, 207, 215],
          "CommentColor": [50, 52, 34],
          "KeywordColor": [192, 186, 242],
          "PreprocessorColor": [255, 195, 155],
          "StringsColor": [181, 213, 198]
        },
        "html": {
          "AttributeNameColor": [255, 195, 155],
          "AttributeValueColor": [255, 195, 155],
          "CdataSectionColor": [162, 196, 240],
          "CharacterColor": [139, 207, 215],
          "CommentColor": [50, 52, 34],
          "DoctypeDeclarationColor": [181, 213, 198],
          "ErrorColor": [213, 162, 208],
          "OperatorColor": [192, 186, 242],
          "ProcessingInstructionColor": [181, 213, 198],
          "TagColor": [211, 114, 106]
        },
        "java": {
          "CharactersColor": [139, 207, 215],
          "CommentColor": [50, 52, 34],
          "KeywordColor": [192, 186, 242],
          "StringsColor": [181, 213, 198]
        },
        "tlc": {
          "CommentColor": [50, 52, 34],
          "KeywordColor": [192, 186, 242],
          "MacroColor": [255, 195, 155],
          "StringsColor": [181, 213, 198]
        },
        "verilog": {
          "CommentColor": [50, 52, 34],
          "KeywordColor": [192, 186, 242],
          "OperatorColor": [255, 195, 155],
          "StringColor": [181, 213, 198]
        },
        "vhdl": {
          "CommentColor": [50, 52, 34],
          "KeywordColor": [192, 186, 242],
          "OperatorColor": [255, 195, 155],
          "StringColor": [181, 213, 198]
        }
      }
    },
    "appdesigner": {
      "codeview": {
        "ReadonlyBackgroundColor": [40, 41, 24]
      }
    }
  }
}
