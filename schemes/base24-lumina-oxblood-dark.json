{
  "ColorSchemeName": "Lumina Oxblood Dark",
  "ColorSchemeAuthor": "Razik Ikhlef (https://github.com/RazikSF)",
  "Note": "Apply this theme in Matlab using the tinted_import function, available at https://github.com/tinted-theming/tinted-matlab",

  "matlab": {
    "colors": {
      "ForegroundColor": [232, 214, 220],
      "BackgroundColor": [32, 15, 22],
      "KeywordColor": [191, 182, 249],
      "CommentColor": [59, 38, 46],
      "StringColor": [125, 199, 151],
      "UnterminatedStringColor": [221, 183, 237],
      "SystemCommandColor": [111, 202, 212],
      "SyntaxErrorColor": [219, 108, 99],
      "commandwindow": {
        "HyperlinkColor": [154, 195, 248],
        "ErrorColor": [219, 108, 99],
        "WarningColor": [249, 200, 117]
      },
      "programmingtools": {
        "CodeAnalyzerWarningColor": [249, 200, 117],
        "AutofixHighlightColor": [249, 200, 117],
        "VariableHighlightColor": [111, 202, 212],
        "VariablesWithSharedScopeColor": [251, 172, 116]
      }
    },
    "editor": {
      "displaysettings": {
        "HighlightCurrentLineColor": [38, 19, 27],
        "linelimit": {
          "LineColor": [48, 28, 36]
        }
      },
      "language": {
        "cpp": {
          "BadCharactersColor": [221, 183, 237],
          "CharactersColor": [111, 202, 212],
          "CommentColor": [59, 38, 46],
          "KeywordColor": [191, 182, 249],
          "PreprocessorColor": [251, 172, 116],
          "StringsColor": [125, 199, 151]
        },
        "html": {
          "AttributeNameColor": [251, 172, 116],
          "AttributeValueColor": [251, 172, 116],
          "CdataSectionColor": [154, 195, 248],
          "CharacterColor": [111, 202, 212],
          "CommentColor": [59, 38, 46],
          "DoctypeDeclarationColor": [125, 199, 151],
          "ErrorColor": [221, 183, 237],
          "OperatorColor": [191, 182, 249],
          "ProcessingInstructionColor": [125, 199, 151],
          "TagColor": [219, 108, 99]
        },
        "java": {
          "CharactersColor": [111, 202, 212],
          "CommentColor": [59, 38, 46],
          "KeywordColor": [191, 182, 249],
          "StringsColor": [125, 199, 151]
        },
        "tlc": {
          "CommentColor": [59, 38, 46],
          "KeywordColor": [191, 182, 249],
          "MacroColor": [251, 172, 116],
          "StringsColor": [125, 199, 151]
        },
        "verilog": {
          "CommentColor": [59, 38, 46],
          "KeywordColor": [191, 182, 249],
          "OperatorColor": [251, 172, 116],
          "StringColor": [125, 199, 151]
        },
        "vhdl": {
          "CommentColor": [59, 38, 46],
          "KeywordColor": [191, 182, 249],
          "OperatorColor": [251, 172, 116],
          "StringColor": [125, 199, 151]
        }
      }
    },
    "appdesigner": {
      "codeview": {
        "ReadonlyBackgroundColor": [48, 28, 36]
      }
    }
  }
}
