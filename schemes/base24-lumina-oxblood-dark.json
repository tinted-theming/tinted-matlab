        "vhdl": {
          "CommentColor": [61, 47, 51],
          "KeywordColor": [190, 181, 252],
          "OperatorColor": [252, 169, 112],
          "StringColor": [125, 199, 151]
        }
      }
    },
    "appdesigner": {
      "codeview": {
        "ReadonlyBackgroundColor": [51, 37, 41]
      }
    }
