{
  "ColorSchemeName": "Lumina Harbor Dark",
  "ColorSchemeAuthor": "Razik Ikhlef (https://github.com/RazikSF)",
  "Note": "Apply this theme in Matlab using the tinted_import function, available at https://github.com/tinted-theming/tinted-matlab",

  "matlab": {
    "colors": {
      "ForegroundColor": [221, 225, 235],
      "BackgroundColor": [13, 17, 29],
      "KeywordColor": [193, 187, 239],
      "CommentColor": [35, 40, 55],
      "StringColor": [155, 216, 180],
      "UnterminatedStringColor": [211, 169, 221],
      "SystemCommandColor": [145, 207, 214],
      "SyntaxErrorColor": [208, 117, 108],
      "commandwindow": {
        "HyperlinkColor": [145, 197, 234],
        "ErrorColor": [208, 117, 108],
        "WarningColor": [234, 206, 140]
      },
      "programmingtools": {
        "CodeAnalyzerWarningColor": [234, 206, 140],
        "AutofixHighlightColor": [234, 206, 140],
        "VariableHighlightColor": [145, 207, 214],
        "VariablesWithSharedScopeColor": [244, 178, 133]
      }
    },
    "editor": {
      "displaysettings": {
        "HighlightCurrentLineColor": [17, 21, 35],
        "linelimit": {
          "LineColor": [26, 31, 45]
        }
      },
      "language": {
        "cpp": {
          "BadCharactersColor": [211, 169, 221],
          "CharactersColor": [145, 207, 214],
          "CommentColor": [35, 40, 55],
          "KeywordColor": [193, 187, 239],
          "PreprocessorColor": [244, 178, 133],
          "StringsColor": [155, 216, 180]
        },
        "html": {
          "AttributeNameColor": [244, 178, 133],
          "AttributeValueColor": [244, 178, 133],
          "CdataSectionColor": [145, 197, 234],
          "CharacterColor": [145, 207, 214],
          "CommentColor": [35, 40, 55],
          "DoctypeDeclarationColor": [155, 216, 180],
          "ErrorColor": [211, 169, 221],
          "OperatorColor": [193, 187, 239],
          "ProcessingInstructionColor": [155, 216, 180],
          "TagColor": [208, 117, 108]
        },
        "java": {
          "CharactersColor": [145, 207, 214],
          "CommentColor": [35, 40, 55],
          "KeywordColor": [193, 187, 239],
          "StringsColor": [155, 216, 180]
        },
        "tlc": {
          "CommentColor": [35, 40, 55],
          "KeywordColor": [193, 187, 239],
          "MacroColor": [244, 178, 133],
          "StringsColor": [155, 216, 180]
        },
        "verilog": {
          "CommentColor": [35, 40, 55],
          "KeywordColor": [193, 187, 239],
          "OperatorColor": [244, 178, 133],
          "StringColor": [155, 216, 180]
        },
        "vhdl": {
          "CommentColor": [35, 40, 55],
          "KeywordColor": [193, 187, 239],
          "OperatorColor": [244, 178, 133],
          "StringColor": [155, 216, 180]
        }
      }
    },
    "appdesigner": {
      "codeview": {
        "ReadonlyBackgroundColor": [26, 31, 45]
      }
    }
  }
}
