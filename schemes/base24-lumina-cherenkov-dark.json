{
  "ColorSchemeName": "Lumina Cherenkov Dark",
  "ColorSchemeAuthor": "Razik Ikhlef (https://github.com/RazikSF)",
  "Note": "Apply this theme in Matlab using the tinted_import function, available at https://github.com/tinted-theming/tinted-matlab",

  "matlab": {
    "colors": {
      "ForegroundColor": [208, 220, 233],
      "BackgroundColor": [10, 17, 31],
      "KeywordColor": [205, 174, 242],
      "CommentColor": [32, 40, 58],
      "StringColor": [139, 210, 154],
      "UnterminatedStringColor": [231, 163, 224],
      "SystemCommandColor": [106, 208, 219],
      "SyntaxErrorColor": [218, 97, 89],
      "commandwindow": {
        "HyperlinkColor": [196, 219, 237],
        "ErrorColor": [218, 97, 89],
        "WarningColor": [224, 185, 85]
      },
      "programmingtools": {
        "CodeAnalyzerWarningColor": [224, 185, 85],
        "AutofixHighlightColor": [224, 185, 85],
        "VariableHighlightColor": [106, 208, 219],
        "VariablesWithSharedScopeColor": [253, 167, 105]
      }
    },
    "editor": {
      "displaysettings": {
        "HighlightCurrentLineColor": [14, 21, 37],
        "linelimit": {
          "LineColor": [22, 31, 47]
        }
      },
      "language": {
        "cpp": {
          "BadCharactersColor": [231, 163, 224],
          "CharactersColor": [106, 208, 219],
          "CommentColor": [32, 40, 58],
          "KeywordColor": [205, 174, 242],
          "PreprocessorColor": [253, 167, 105],
          "StringsColor": [139, 210, 154]
        },
        "html": {
          "AttributeNameColor": [253, 167, 105],
          "AttributeValueColor": [253, 167, 105],
          "CdataSectionColor": [196, 219, 237],
          "CharacterColor": [106, 208, 219],
          "CommentColor": [32, 40, 58],
          "DoctypeDeclarationColor": [139, 210, 154],
          "ErrorColor": [231, 163, 224],
          "OperatorColor": [205, 174, 242],
          "ProcessingInstructionColor": [139, 210, 154],
          "TagColor": [218, 97, 89]
        },
        "java": {
          "CharactersColor": [106, 208, 219],
          "CommentColor": [32, 40, 58],
          "KeywordColor": [205, 174, 242],
          "StringsColor": [139, 210, 154]
        },
        "tlc": {
          "CommentColor": [32, 40, 58],
          "KeywordColor": [205, 174, 242],
          "MacroColor": [253, 167, 105],
          "StringsColor": [139, 210, 154]
        },
        "verilog": {
          "CommentColor": [32, 40, 58],
          "KeywordColor": [205, 174, 242],
          "OperatorColor": [253, 167, 105],
          "StringColor": [139, 210, 154]
        },
        "vhdl": {
          "CommentColor": [32, 40, 58],
          "KeywordColor": [205, 174, 242],
          "OperatorColor": [253, 167, 105],
          "StringColor": [139, 210, 154]
        }
      }
    },
    "appdesigner": {
      "codeview": {
        "ReadonlyBackgroundColor": [22, 31, 47]
      }
    }
  }
}
