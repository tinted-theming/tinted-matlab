{
  "ColorSchemeName": "Lumina Aurora Dark",
  "ColorSchemeAuthor": "Razik Ikhlef (https://github.com/RazikSF)",
  "Note": "Apply this theme in Matlab using the tinted_import function, available at https://github.com/tinted-theming/tinted-matlab",

  "matlab": {
    "colors": {
      "ForegroundColor": [214, 227, 226],
      "BackgroundColor": [4, 18, 18],
      "KeywordColor": [191, 158, 241],
      "CommentColor": [24, 42, 42],
      "StringColor": [108, 215, 157],
      "UnterminatedStringColor": [231, 173, 225],
      "SystemCommandColor": [132, 210, 219],
      "SyntaxErrorColor": [216, 111, 102],
      "commandwindow": {
        "HyperlinkColor": [197, 216, 237],
        "ErrorColor": [216, 111, 102],
        "WarningColor": [233, 212, 135]
      },
      "programmingtools": {
        "CodeAnalyzerWarningColor": [233, 212, 135],
        "AutofixHighlightColor": [233, 212, 135],
        "VariableHighlightColor": [132, 210, 219],
        "VariablesWithSharedScopeColor": [252, 176, 124]
      }
    },
    "editor": {
      "displaysettings": {
        "HighlightCurrentLineColor": [6, 23, 23],
        "linelimit": {
          "LineColor": [15, 32, 32]
        }
      },
      "language": {
        "cpp": {
          "BadCharactersColor": [231, 173, 225],
          "CharactersColor": [132, 210, 219],
          "CommentColor": [24, 42, 42],
          "KeywordColor": [191, 158, 241],
          "PreprocessorColor": [252, 176, 124],
          "StringsColor": [108, 215, 157]
        },
        "html": {
          "AttributeNameColor": [252, 176, 124],
          "AttributeValueColor": [252, 176, 124],
          "CdataSectionColor": [197, 216, 237],
          "CharacterColor": [132, 210, 219],
          "CommentColor": [24, 42, 42],
          "DoctypeDeclarationColor": [108, 215, 157],
          "ErrorColor": [231, 173, 225],
          "OperatorColor": [191, 158, 241],
          "ProcessingInstructionColor": [108, 215, 157],
          "TagColor": [216, 111, 102]
        },
        "java": {
          "CharactersColor": [132, 210, 219],
          "CommentColor": [24, 42, 42],
          "KeywordColor": [191, 158, 241],
          "StringsColor": [108, 215, 157]
        },
        "tlc": {
          "CommentColor": [24, 42, 42],
          "KeywordColor": [191, 158, 241],
          "MacroColor": [252, 176, 124],
          "StringsColor": [108, 215, 157]
        },
        "verilog": {
          "CommentColor": [24, 42, 42],
          "KeywordColor": [191, 158, 241],
          "OperatorColor": [252, 176, 124],
          "StringColor": [108, 215, 157]
        },
        "vhdl": {
          "CommentColor": [24, 42, 42],
          "KeywordColor": [191, 158, 241],
          "OperatorColor": [252, 176, 124],
          "StringColor": [108, 215, 157]
        }
      }
    },
    "appdesigner": {
      "codeview": {
        "ReadonlyBackgroundColor": [15, 32, 32]
      }
    }
  }
}
