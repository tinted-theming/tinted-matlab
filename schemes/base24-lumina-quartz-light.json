{
  "ColorSchemeName": "Lumina Quartz Light",
  "ColorSchemeAuthor": "Razik Ikhlef (https://github.com/RazikSF)",
  "Note": "Apply this theme in Matlab using the tinted_import function, available at https://github.com/tinted-theming/tinted-matlab",

  "matlab": {
    "colors": {
      "ForegroundColor": [48, 53, 59],
      "BackgroundColor": [245, 247, 250],
      "KeywordColor": [118, 83, 165],
      "CommentColor": [210, 212, 217],
      "StringColor": [33, 117, 80],
      "UnterminatedStringColor": [130, 82, 126],
      "SystemCommandColor": [0, 112, 146],
      "SyntaxErrorColor": [125, 43, 40],
      "commandwindow": {
        "HyperlinkColor": [68, 104, 148],
        "ErrorColor": [125, 43, 40],
        "WarningColor": [154, 100, 44]
      },
      "programmingtools": {
        "CodeAnalyzerWarningColor": [154, 100, 44],
        "AutofixHighlightColor": [154, 100, 44],
        "VariableHighlightColor": [0, 112, 146],
        "VariablesWithSharedScopeColor": [135, 76, 42]
      }
    },
    "editor": {
      "displaysettings": {
        "HighlightCurrentLineColor": [238, 240, 245],
        "linelimit": {
