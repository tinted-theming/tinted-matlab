{
  "ColorSchemeName": "nordfox",
  "ColorSchemeAuthor": "EdenEast (https://github.com/EdenEast)",
  "Note": "Apply this theme in Matlab using the tinted_import function, available at https://github.com/tinted-theming/tinted-matlab",

  "matlab": {
    "colors": {
      "ForegroundColor": [205, 206, 207],
      "BackgroundColor": [46, 52, 64],
      "KeywordColor": [180, 142, 173],
      "CommentColor": [70, 87, 128],
      "StringColor": [163, 190, 140],
      "UnterminatedStringColor": [191, 136, 188],
      "SystemCommandColor": [136, 192, 208],
      "SyntaxErrorColor": [191, 97, 106],
      "commandwindow": {
        "HyperlinkColor": [129, 161, 193],
        "ErrorColor": [191, 97, 106],
        "WarningColor": [235, 203, 139]
      },
      "programmingtools": {
        "CodeAnalyzerWarningColor": [235, 203, 139],
        "AutofixHighlightColor": [235, 203, 139],
        "VariableHighlightColor": [136, 192, 208],
        "VariablesWithSharedScopeColor": [201, 130, 107]
      }
    },
    "editor": {
