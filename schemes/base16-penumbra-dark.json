{
  "ColorSchemeName": "Penumbra Dark",
  "ColorSchemeAuthor": "Neal McKee (https://github.com/nealmckee/penumbra)",
  "Note": "Apply this theme in Matlab using the tinted_import function, available at https://github.com/tinted-theming/tinted-matlab",

  "matlab": {
    "colors": {
      "ForegroundColor": [139, 139, 139],
      "BackgroundColor": [44, 46, 49],
      "KeywordColor": [113, 118, 174],
      "CommentColor": [94, 96, 99],
      "StringColor": [79, 145, 88],
      "UnterminatedStringColor": [156, 103, 161],
      "SystemCommandColor": [0, 137, 134],
      "SyntaxErrorColor": [186, 97, 106],
      "commandwindow": {
        "HyperlinkColor": [0, 129, 180],
        "ErrorColor": [186, 97, 106],
        "WarningColor": [148, 138, 29]
      },
      "programmingtools": {
        "CodeAnalyzerWarningColor": [148, 138, 29],
        "AutofixHighlightColor": [148, 138, 29],
        "VariableHighlightColor": [0, 137, 134],
        "VariablesWithSharedScopeColor": [179, 118, 62]
      }
    },
    "editor": {
