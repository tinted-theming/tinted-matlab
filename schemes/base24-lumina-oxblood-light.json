{
  "ColorSchemeName": "Lumina Oxblood Light",
  "ColorSchemeAuthor": "Razik Ikhlef (https://github.com/RazikSF)",
  "Note": "Apply this theme in Matlab using the tinted_import function, available at https://github.com/tinted-theming/tinted-matlab",

  "matlab": {
    "colors": {
      "ForegroundColor": [66, 34, 47],
      "BackgroundColor": [254, 242, 244],
      "KeywordColor": [101, 86, 163],
      "CommentColor": [222, 206, 209],
      "StringColor": [35, 119, 66],
      "UnterminatedStringColor": [130, 70, 157],
      "SystemCommandColor": [8, 115, 128],
      "SyntaxErrorColor": [155, 40, 39],
      "commandwindow": {
        "HyperlinkColor": [49, 102, 166],
        "ErrorColor": [155, 40, 39],
        "WarningColor": [161, 96, 10]
      },
      "programmingtools": {
        "CodeAnalyzerWarningColor": [161, 96, 10],
        "AutofixHighlightColor": [161, 96, 10],
        "VariableHighlightColor": [8, 115, 128],
        "VariablesWithSharedScopeColor": [158, 81, 31]
      }
    },
    "editor": {
