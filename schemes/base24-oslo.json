        "verilog": {
          "CommentColor": [108, 114, 127],
          "KeywordColor": [193, 98, 222],
          "OperatorColor": [216, 114, 90],
          "StringColor": [140, 194, 101]
        },
        "vhdl": {
          "CommentColor": [108, 114, 127],
          "KeywordColor": [193, 98, 222],
          "OperatorColor": [216, 114, 90],
          "StringColor": [140, 194, 101]
        }
      }
    },
    "appdesigner": {
      "codeview": {
        "ReadonlyBackgroundColor": [76, 81, 94]
      }
    }
