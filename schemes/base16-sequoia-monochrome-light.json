{
  "ColorSchemeName": "Sequoia Monochrome Light",
  "ColorSchemeAuthor": "Micheal Andreuzza (https://michaelandreuzza.com/)",
  "Note": "Apply this theme in Matlab using the tinted_import function, available at https://github.com/tinted-theming/tinted-matlab",

  "matlab": {
    "colors": {
      "ForegroundColor": [40, 41, 48],
      "BackgroundColor": [237, 238, 242],
      "KeywordColor": [80, 83, 94],
      "CommentColor": [157, 162, 173],
      "StringColor": [46, 48, 56],
      "UnterminatedStringColor": [46, 48, 56],
      "SystemCommandColor": [69, 71, 82],
      "SyntaxErrorColor": [82, 86, 102],
      "commandwindow": {
        "HyperlinkColor": [95, 99, 112],
        "ErrorColor": [82, 86, 102],
        "WarningColor": [80, 83, 94]
      },
      "programmingtools": {
        "CodeAnalyzerWarningColor": [80, 83, 94],
        "AutofixHighlightColor": [80, 83, 94],
        "VariableHighlightColor": [69, 71, 82],
        "VariablesWithSharedScopeColor": [82, 86, 102]
      }
    },
    "editor": {
