{
  "ColorSchemeName": "Lumina Nebula Light",
  "ColorSchemeAuthor": "Razik Ikhlef (https://github.com/RazikSF)",
  "Note": "Apply this theme in Matlab using the tinted_import function, available at https://github.com/tinted-theming/tinted-matlab",

  "matlab": {
    "colors": {
      "ForegroundColor": [45, 44, 70],
      "BackgroundColor": [248, 244, 255],
      "KeywordColor": [93, 64, 177],
      "CommentColor": [214, 209, 223],
      "StringColor": [0, 118, 80],
      "UnterminatedStringColor": [137, 72, 132],
      "SystemCommandColor": [1, 110, 144],
      "SyntaxErrorColor": [147, 34, 34],
      "commandwindow": {
        "HyperlinkColor": [63, 87, 119],
        "ErrorColor": [147, 34, 34],
        "WarningColor": [149, 91, 1]
      },
      "programmingtools": {
        "CodeAnalyzerWarningColor": [149, 91, 1],
        "AutofixHighlightColor": [149, 91, 1],
        "VariableHighlightColor": [1, 110, 144],
        "VariablesWithSharedScopeColor": [147, 73, 22]
      }
    },
    "editor": {
      "displaysettings": {
        "HighlightCurrentLineColor": [242, 237, 251],
        "linelimit": {
          "LineColor": [230, 225, 239]
        }
      },
      "language": {
        "cpp": {
          "BadCharactersColor": [137, 72, 132],
          "CharactersColor": [1, 110, 144],
          "CommentColor": [214, 209, 223],
          "KeywordColor": [93, 64, 177],
          "PreprocessorColor": [147, 73, 22],
          "StringsColor": [0, 118, 80]
        },
        "html": {
          "AttributeNameColor": [147, 73, 22],
          "AttributeValueColor": [147, 73, 22],
          "CdataSectionColor": [63, 87, 119],
          "CharacterColor": [1, 110, 144],
          "CommentColor": [214, 209, 223],
          "DoctypeDeclarationColor": [0, 118, 80],
          "ErrorColor": [137, 72, 132],
          "OperatorColor": [93, 64, 177],
          "ProcessingInstructionColor": [0, 118, 80],
          "TagColor": [147, 34, 34]
        },
        "java": {
          "CharactersColor": [1, 110, 144],
          "CommentColor": [214, 209, 223],
          "KeywordColor": [93, 64, 177],
          "StringsColor": [0, 118, 80]
        },
        "tlc": {
          "CommentColor": [214, 209, 223],
          "KeywordColor": [93, 64, 177],
          "MacroColor": [147, 73, 22],
          "StringsColor": [0, 118, 80]
        },
        "verilog": {
          "CommentColor": [214, 209, 223],
          "KeywordColor": [93, 64, 177],
          "OperatorColor": [147, 73, 22],
          "StringColor": [0, 118, 80]
        },
        "vhdl": {
          "CommentColor": [214, 209, 223],
          "KeywordColor": [93, 64, 177],
          "OperatorColor": [147, 73, 22],
          "StringColor": [0, 118, 80]
        }
      }
    },
    "appdesigner": {
      "codeview": {
        "ReadonlyBackgroundColor": [230, 225, 239]
      }
    }
  }
}
