{
  "ColorSchemeName": "Lumina Espresso Light",
  "ColorSchemeAuthor": "Razik Ikhlef (https://github.com/RazikSF)",
  "Note": "Apply this theme in Matlab using the tinted_import function, available at https://github.com/tinted-theming/tinted-matlab",

  "matlab": {
    "colors": {
      "ForegroundColor": [57, 38, 27],
      "BackgroundColor": [252, 240, 227],
      "KeywordColor": [112, 73, 161],
      "CommentColor": [217, 206, 194],
      "StringColor": [21, 116, 77],
      "UnterminatedStringColor": [134, 75, 129],
      "SystemCommandColor": [0, 112, 131],
      "SyntaxErrorColor": [132, 33, 32],
      "commandwindow": {
        "HyperlinkColor": [40, 104, 163],
        "ErrorColor": [132, 33, 32],
        "WarningColor": [109, 78, 54]
      },
      "programmingtools": {
        "CodeAnalyzerWarningColor": [109, 78, 54],
        "AutofixHighlightColor": [109, 78, 54],
        "VariableHighlightColor": [0, 112, 131],
        "VariablesWithSharedScopeColor": [137, 70, 26]
      }
    },
    "editor": {
      "displaysettings": {
        "HighlightCurrentLineColor": [245, 234, 222],
        "linelimit": {
          "LineColor": [233, 222, 210]
        }
      },
      "language": {
        "cpp": {
          "BadCharactersColor": [134, 75, 129],
          "CharactersColor": [0, 112, 131],
          "CommentColor": [217, 206, 194],
          "KeywordColor": [112, 73, 161],
          "PreprocessorColor": [137, 70, 26],
          "StringsColor": [21, 116, 77]
        },
        "html": {
          "AttributeNameColor": [137, 70, 26],
          "AttributeValueColor": [137, 70, 26],
          "CdataSectionColor": [40, 104, 163],
          "CharacterColor": [0, 112, 131],
          "CommentColor": [217, 206, 194],
          "DoctypeDeclarationColor": [21, 116, 77],
          "ErrorColor": [134, 75, 129],
          "OperatorColor": [112, 73, 161],
          "ProcessingInstructionColor": [21, 116, 77],
          "TagColor": [132, 33, 32]
        },
        "java": {
          "CharactersColor": [0, 112, 131],
          "CommentColor": [217, 206, 194],
          "KeywordColor": [112, 73, 161],
          "StringsColor": [21, 116, 77]
        },
        "tlc": {
          "CommentColor": [217, 206, 194],
          "KeywordColor": [112, 73, 161],
          "MacroColor": [137, 70, 26],
          "StringsColor": [21, 116, 77]
