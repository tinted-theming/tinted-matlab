{
  "ColorSchemeName": "Lumina Lagoon Light",
  "ColorSchemeAuthor": "Razik Ikhlef (https://github.com/RazikSF)",
  "Note": "Apply this theme in Matlab using the tinted_import function, available at https://github.com/tinted-theming/tinted-matlab",

  "matlab": {
    "colors": {
      "ForegroundColor": [11, 50, 59],
      "BackgroundColor": [233, 250, 250],
      "KeywordColor": [113, 83, 181],
      "CommentColor": [197, 216, 216],
      "StringColor": [46, 97, 71],
      "UnterminatedStringColor": [137, 73, 132],
      "SystemCommandColor": [0, 110, 113],
      "SyntaxErrorColor": [143, 33, 33],
      "commandwindow": {
        "HyperlinkColor": [24, 92, 169],
        "ErrorColor": [143, 33, 33],
        "WarningColor": [161, 96, 13]
      },
      "programmingtools": {
        "CodeAnalyzerWarningColor": [161, 96, 13],
        "AutofixHighlightColor": [161, 96, 13],
        "VariableHighlightColor": [0, 110, 113],
        "VariablesWithSharedScopeColor": [146, 73, 24]
      }
    },
    "editor": {
      "displaysettings": {
        "HighlightCurrentLineColor": [225, 244, 244],
        "linelimit": {
          "LineColor": [213, 232, 232]
        }
      },
      "language": {
