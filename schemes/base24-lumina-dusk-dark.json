{
  "ColorSchemeName": "Lumina Dusk Dark",
  "ColorSchemeAuthor": "Razik Ikhlef (https://github.com/RazikSF)",
  "Note": "Apply this theme in Matlab using the tinted_import function, available at https://github.com/tinted-theming/tinted-matlab",

  "matlab": {
    "colors": {
      "ForegroundColor": [224, 220, 234],
      "BackgroundColor": [26, 24, 37],
      "KeywordColor": [193, 187, 240],
      "CommentColor": [50, 48, 64],
      "StringColor": [160, 209, 169],
      "UnterminatedStringColor": [225, 176, 220],
      "SystemCommandColor": [144, 207, 215],
      "SyntaxErrorColor": [208, 116, 108],
      "commandwindow": {
        "HyperlinkColor": [155, 190, 242],
        "ErrorColor": [208, 116, 108],
        "WarningColor": [239, 203, 123]
      },
      "programmingtools": {
        "CodeAnalyzerWarningColor": [239, 203, 123],
        "AutofixHighlightColor": [239, 203, 123],
        "VariableHighlightColor": [144, 207, 215],
        "VariablesWithSharedScopeColor": [245, 178, 132]
      }
    },
    "editor": {
      "displaysettings": {
        "HighlightCurrentLineColor": [31, 28, 43],
        "linelimit": {
          "LineColor": [40, 38, 53]
        }
      },
      "language": {
        "cpp": {
          "BadCharactersColor": [225, 176, 220],
          "CharactersColor": [144, 207, 215],
          "CommentColor": [50, 48, 64],
          "KeywordColor": [193, 187, 240],
          "PreprocessorColor": [245, 178, 132],
          "StringsColor": [160, 209, 169]
        },
        "html": {
          "AttributeNameColor": [245, 178, 132],
          "AttributeValueColor": [245, 178, 132],
          "CdataSectionColor": [155, 190, 242],
          "CharacterColor": [144, 207, 215],
          "CommentColor": [50, 48, 64],
          "DoctypeDeclarationColor": [160, 209, 169],
          "ErrorColor": [225, 176, 220],
          "OperatorColor": [193, 187, 240],
          "ProcessingInstructionColor": [160, 209, 169],
          "TagColor": [208, 116, 108]
        },
        "java": {
          "CharactersColor": [144, 207, 215],
          "CommentColor": [50, 48, 64],
          "KeywordColor": [193, 187, 240],
          "StringsColor": [160, 209, 169]
        },
        "tlc": {
          "CommentColor": [50, 48, 64],
          "KeywordColor": [193, 187, 240],
          "MacroColor": [245, 178, 132],
          "StringsColor": [160, 209, 169]
        },
        "verilog": {
          "CommentColor": [50, 48, 64],
          "KeywordColor": [193, 187, 240],
          "OperatorColor": [245, 178, 132],
          "StringColor": [160, 209, 169]
        },
        "vhdl": {
          "CommentColor": [50, 48, 64],
          "KeywordColor": [193, 187, 240],
          "OperatorColor": [245, 178, 132],
          "StringColor": [160, 209, 169]
        }
      }
    },
    "appdesigner": {
      "codeview": {
        "ReadonlyBackgroundColor": [40, 38, 53]
      }
    }
  }
}
